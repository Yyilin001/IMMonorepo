# Copy this file once per application node. IM_NODE_SUFFIX, IM_GATEWAY_NODE_ID,
# and IM_COMMAND_NODE_ID identify the local host; the endpoint maps contain every
# Gateway or command node in the Cell.
APP_ENV=production
LOG_LEVEL=info
IM_METRICS_ENABLED=true
JWT_SECRETS=active:replace-with-at-least-32-character-jwt-secret
JWT_ACTIVE_KID=active
IM_INTERNAL_SHARED_SECRET=replace-with-at-least-32-character-internal-secret
IM_NODE_DISPATCH_SHARED_SECRET=replace-with-at-least-32-character-node-dispatch-secret
IM_CELL_INGRESS_SHARED_SECRET=replace-with-at-least-32-character-cell-ingress-secret
IM_NODE_SUFFIX=node-a
IM_GATEWAY_NODE_ID=gateway-node-a
IM_COMMAND_NODE_ID=node-a
# A Cell with two or more node inventories must span at least two zones. This
# label is deployment metadata only; it is validated before rollout and is not
# used as an application routing key.
IM_AVAILABILITY_ZONE=cn-south-1a

# Realtime Cell. A Cell owns its local Gateway nodes and Redis presence keys.
IM_REALTIME_CELL_ID=cell-shenzhen-a
# Configure each Cell role explicitly. Legacy IM_REALTIME_CELL_INGRESS_ENDPOINTS
# is accepted only for deployments that provide a trusted internal L7 router.
IM_CELL_INGRESS_COMMAND_ENDPOINTS=cell-shenzhen-a=https://command-api-cell-shenzhen-a.internal
IM_CELL_INGRESS_QUERY_ENDPOINTS=cell-shenzhen-a=https://query-api-cell-shenzhen-a.internal
IM_CELL_INGRESS_REALTIME_ENDPOINTS=cell-shenzhen-a=https://gateway-cell-shenzhen-a.internal

# Every Gateway in this Cell must be listed. The local IM_GATEWAY_NODE_ID must
# have a matching HTTPS endpoint.
IM_NODE_DISPATCH_MODE=http
IM_GATEWAY_NODE_DISPATCH_ENDPOINTS=gateway-node-a=https://gateway-node-a.internal,gateway-node-b=https://gateway-node-b.internal

# Command owner routing. The local IM_COMMAND_NODE_ID must be one of these keys.
IM_SEQUENCE_ALLOCATION_MODE=block
IM_SEQUENCE_BLOCK_SIZE=256
IM_COMMAND_NODE_URLS=node-a=https://command-api-a.internal:8081,node-b=https://command-api-b.internal:8081
IM_COMMAND_INTERNAL_SHARED_SECRET=replace-with-at-least-32-character-command-secret

# Valkey Cluster. REDIS_URL remains a bootstrap/default endpoint for components
# that require one, while Cluster-aware components use the explicit seed list.
REDIS_URL=redis://valkey-1.internal:6379
IM_REDIS_DEPLOYMENT_TOPOLOGY=cluster
IM_REDIS_CLUSTER_NODES=valkey-1.internal:6379,valkey-2.internal:6379,valkey-3.internal:6379
IM_REDIS_MAX_CONNECTIONS=64
IM_ROUTING_MODE=redis
IM_REDIS_PRESENCE_HEARTBEAT_TIMEOUT_SECONDS=90
IM_REDIS_ACTIVE_CONVERSATION_ROUTE_TTL_SECONDS=900
IM_REDIS_ACTIVE_CONVERSATION_ROUTE_CACHE_TTL_SECONDS=2

# Private application endpoints. These are HTTPS in production and should be
# reachable only on the service network.
IM_COMMAND_API_INTERNAL_BASE_URL=https://command-api.internal:8081
IM_GATEWAY_INTERNAL_BASE_URL=https://gateway.internal:18080

# Shared write/read behavior.
IM_GROUP_MEMBER_LIMIT=1000
IM_HOT_CONVERSATION_MSG_PER_SECOND_LIMIT=200
IM_CONVERSATION_MEMBER_CACHE_TTL_SECONDS=10
IM_MESSAGE_WRITE_BATCH_ENABLED=true
IM_MESSAGE_WRITE_BATCH_MAX_SIZE=32
IM_MESSAGE_WRITE_BATCH_MAX_DELAY_MS=10
IM_MESSAGE_CREATED_RECIPIENT_INLINE_THRESHOLD=500
IM_DOMAIN_EVENT_RECIPIENT_SNAPSHOT_DEDUP_THRESHOLD=500
IM_TIMELINE_SINCE_HOT_CACHE_TTL_MS=250
IM_TIMELINE_SINCE_HOT_CACHE_MAX_ENTRIES=4096
IM_TIMELINE_SINCE_RECENT_CACHE_TTL_MS=2000
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_CONVERSATIONS=1024
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_ITEMS_PER_CONVERSATION=512
IM_TIMELINE_SINCE_TARGET_SEQUENCE_COALESCE_WINDOW_MS=5
IM_TIMELINE_SINCE_CACHE_INVALIDATION_MODE=redis
IM_TIMELINE_SINCE_CACHE_INVALIDATION_REDIS_MAX_CONNECTIONS=2
IM_SUMMARY_RESPONSE_MEMBER_USER_IDS_LIMIT=500

# Gateway protection and hot-group realtime tuning.
IM_TCP_LISTEN_BACKLOG=8192
IM_TCP_MAX_CONNECTIONS=20000
IM_TCP_MAX_NEW_CONNECTIONS_PER_SECOND=500
IM_TCP_REQUIRES_TLS_TERMINATION=true
IM_TCP_DROP_REALTIME_WHEN_NOT_WRITABLE=true
IM_GATEWAY_LOCAL_FANOUT_BATCH_SIZE=64
IM_GATEWAY_LOCAL_FANOUT_EVENT_LOOP_YIELD_CHUNKS=64
IM_GATEWAY_RELAY_DOMAIN_EVENT_PACKET_MAX_BODY_BYTES=1048576
IM_GATEWAY_RELAY_DOMAIN_EVENT_PACKET_BIN_MAX_BODY_BYTES=1048576
IM_GATEWAY_RELAY_DOMAIN_EVENT_PACKETS_MAX_BODY_BYTES=262144
IM_REALTIME_REMOTE_DISPATCH_USER_BATCH_SIZE=512
IM_REALTIME_REMOTE_DISPATCH_MAX_IN_FLIGHT=8
IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_ENABLED=true
IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_RECIPIENT_THRESHOLD=500
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_LIMIT=128
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_MODE=compact-only
IM_REALTIME_ACTIVE_COMPACT_HINT_PREVIEW_MAX_CHARS=120
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_PAYLOAD_BYTE_BUDGET=262144
IM_REALTIME_INACTIVE_CONVERSATION_HINT_MODE=pull-only
IM_REALTIME_INACTIVE_CONVERSATION_HINT_DEBOUNCE_SECONDS=1
IM_REALTIME_INACTIVE_CONVERSATION_HINT_MAX_PENDING_RECIPIENTS=5000

# Stream consumer batching and large-group protection.
IM_STREAM_CONSUMER_QUEUE_CAPACITY=512
IM_STREAM_CONSUMER_RUN_BATCH_SIZE=32
IM_STREAM_CONSUMER_BATCH_FILL_WAIT_MS=10
IM_STREAM_CONSUMER_REQUIRE_MESSAGE_CREATED_RECIPIENT_SNAPSHOT=true
IM_SUMMARY_PROJECTION_MESSAGE_CREATED_ACTIVITY_ONLY_RECIPIENT_THRESHOLD=500
IM_SUMMARY_PROJECTION_ACTIVITY_COALESCE_WINDOW_MS=500
IM_DOMAIN_DELIVERY_MESSAGE_CREATED_LARGE_GROUP_MODE=timeline-pull
IM_DOMAIN_DELIVERY_MESSAGE_CREATED_OWNER_DELIVERY_SKIP_RECIPIENT_THRESHOLD=500
IM_DOMAIN_DELIVERY_OWNER_RECORD_BATCH_MAX_REQUESTS=1000
IM_NOTIFICATION_MESSAGE_CREATED_OWNER_NOTIFICATION_SKIP_RECIPIENT_THRESHOLD=500
IM_REALTIME_MESSAGE_CREATED_LIGHTWEIGHT_RECIPIENT_THRESHOLD=500
IM_REALTIME_MESSAGE_CREATED_LIGHTWEIGHT_PREVIEW_MAX_CHARS=120
IM_REALTIME_MESSAGE_CREATED_PREVIEW_LOOKUP_ENABLED=false
IM_REALTIME_ACTIVE_CONVERSATION_ROUTE_CACHE_TTL_MS=1000
IM_REALTIME_ACTIVE_CONVERSATION_ROUTE_CACHE_MAX_ENTRIES=4096
IM_REALTIME_MESSAGE_CREATED_COALESCE_WINDOW_MS=1000
IM_REALTIME_ACTIVE_COMPACT_HINT_COALESCE_WINDOW_MS=25
IM_REALTIME_DELIVERY_ASYNC_RELAY_ENABLED=true
IM_REALTIME_DELIVERY_ASYNC_MAX_IN_FLIGHT=32
IM_REALTIME_DELIVERY_ASYNC_MAX_QUEUED=1024

# Database
POSTGRES_HOST=postgres-primary.internal
POSTGRES_REPLICA_HOST=postgres-replica.internal
POSTGRES_PORT=5432
POSTGRES_USER=imserver
POSTGRES_PASSWORD=replace-with-password
POSTGRES_DB=imserver

# Conversation shards. Add more shard IDs and matching DBs before capacity tests.
IM_CONVERSATION_SHARD_IDS=shard-0,shard-1
DATABASE_CONVERSATION_SHARD_0_HOST=postgres-conv-0.internal
DATABASE_CONVERSATION_SHARD_0_NAME=imserver_conv_0
DATABASE_CONVERSATION_SHARD_1_HOST=postgres-conv-1.internal
DATABASE_CONVERSATION_SHARD_1_NAME=imserver_conv_1

# Summary shards by ownerUserID.
IM_SUMMARY_SHARD_IDS=summary-a,summary-b
DATABASE_SUMMARY_SUMMARY_A_HOST=postgres-summary-a.internal
DATABASE_SUMMARY_SUMMARY_A_NAME=imserver_summary_a
DATABASE_SUMMARY_SUMMARY_B_HOST=postgres-summary-b.internal
DATABASE_SUMMARY_SUMMARY_B_NAME=imserver_summary_b
IM_SUMMARY_PROJECTION_WRITE_MODE=sharded
IM_SUMMARY_QUERY_READ_SOURCE=sharded

# Kafka is the durable domain event stream. Use mTLS/SASL in production.
IM_EVENT_STREAM_DRIVER=kafka
IM_KAFKA_BROKERS=kafka-1.internal:9092,kafka-2.internal:9092,kafka-3.internal:9092
IM_KAFKA_TOPIC=conversation-domain-events
IM_KAFKA_DEAD_LETTER_TOPIC=conversation-domain-events-dead-letter
# Kafka topic capacity is deployment state, not an application default. Keep
# these values identical in every Cell inventory. Do not increase partitions on
# a live event topic without an ordering review; use a new topic generation or
# a Cell migration when the conversation-key partition plan must change.
IM_KAFKA_EVENT_TOPIC_PARTITIONS=48
IM_KAFKA_EVENT_TOPIC_REPLICATION_FACTOR=3
IM_KAFKA_EVENT_TOPIC_MIN_IN_SYNC_REPLICAS=2
IM_KAFKA_EVENT_TOPIC_RETENTION_HOURS=72
IM_KAFKA_DEAD_LETTER_TOPIC_PARTITIONS=12
IM_KAFKA_DEAD_LETTER_TOPIC_REPLICATION_FACTOR=3
IM_KAFKA_DEAD_LETTER_TOPIC_MIN_IN_SYNC_REPLICAS=2
IM_KAFKA_DEAD_LETTER_TOPIC_RETENTION_HOURS=168
IM_KAFKA_REQUIRED_ACKS=all
IM_KAFKA_COMPRESSION=lz4
IM_KAFKA_AUTO_CREATE_TOPICS=false
IM_KAFKA_SECURITY_PROTOCOL=sasl_tls
IM_KAFKA_SASL_MECHANISM=scram-sha-512
IM_KAFKA_SASL_USERNAME=imserver
IM_KAFKA_SASL_PASSWORD=replace-with-kafka-password
IM_KAFKA_TLS_CA_FILE=/run/secrets/kafka-ca.pem

IM_SEARCH_DRIVER=database

# Media must not be local in production.
MEDIA_STORAGE_PROVIDER=s3compatible
MEDIA_STORAGE_S3_ENDPOINT=https://oss.internal
MEDIA_STORAGE_S3_BUCKET=im-media
MEDIA_STORAGE_S3_ACCESS_KEY_ID=replace-me
MEDIA_STORAGE_S3_SECRET_ACCESS_KEY=replace-me
MEDIA_STORAGE_S3_REGION=cn-shenzhen
MEDIA_STORAGE_S3_FORCE_PATH_STYLE=true
