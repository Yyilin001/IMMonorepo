# Account 与 Gateway 使用相同的资源 binding、分发地址和分发密钥。
# 与 IM_V2_LOCAL_MEDIA_MODE 二选一。旧资源需要在 JSON 中保留原 local binding。
IM_V2_RESOURCE_MODE=enabled
IM_V2_RESOURCE_WORK_DIRECTORY=/srv/im/resource-work
IM_V2_RESOURCE_PUBLIC_BASE_URL=https://your-account-edge.example
IM_V2_RESOURCE_SIGNING_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
IM_V2_RESOURCE_MAXIMUM_BYTES=268435456
IM_V2_RESOURCE_STORAGE_BINDINGS_JSON='[{"id":"aliyun-oss","revision":1,"kind":"oss","oss":{"bucket":"REPLACE_WITH_PRIVATE_BUCKET","region":"cn-shenzhen","endpoint":"https://REPLACE_WITH_PRIVATE_BUCKET.oss-cn-shenzhen.aliyuncs.com","prefix":"imv2/"}}]'
IM_V2_RESOURCE_DEFAULT_BINDING=aliyun-oss
IM_V2_RESOURCE_DEFAULT_REVISION=1
# 凭据由部署环境注入；禁止提交真实值。临时凭据还需 SECURITY_TOKEN。
IM_V2_OSS_ACCESS_KEY_ID=
IM_V2_OSS_ACCESS_KEY_SECRET=
IM_V2_OSS_SECURITY_TOKEN=
# 使用临时凭据时填写 ISO-8601 到期时间；到期前需轮换并重启使用环境变量的进程。
IM_V2_OSS_CREDENTIAL_EXPIRATION=
