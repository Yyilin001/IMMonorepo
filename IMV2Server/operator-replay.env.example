# This is a separate loopback-only control-plane process. Never publish this
# listener directly and never reuse a customer access token here. Reach it only
# through an approved bastion or mTLS-authenticated operator proxy.
IM_V2_DATABASE_URL=postgres://im_v2:change-me@127.0.0.1:5432/im_v2
IM_V2_DATABASE_EVENT_LOOP_THREADS=2
IM_V2_DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=4
IM_V2_DATABASE_MAX_TOTAL_CONNECTIONS=32
IM_V2_MAX_USER_SHARD_STORES=16
IM_V2_DATABASE_CONNECT_TIMEOUT_MS=5000
IM_V2_DATABASE_POOL_TIMEOUT_MS=3000
IM_V2_DATABASE_STATEMENT_TIMEOUT_MS=30000
IM_V2_DATABASE_LOCK_TIMEOUT_MS=5000
IM_V2_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
IM_V2_OPERATOR_REPLAY_LISTEN_HOST=127.0.0.1
IM_V2_OPERATOR_REPLAY_LISTEN_PORT=9445
# Base64 of at least 32 random bytes. Keep it in the operator secret scope;
# the caller presents this exact base64 string as its Bearer credential.
IM_V2_OPERATOR_REPLAY_BEARER_TOKEN_BASE64=replace-with-random-32-byte-or-longer-base64
# Stable, non-personal, audited operator-service principal (letters, digits,
# dash, underscore, dot and colon only). Human identity belongs in the mTLS/
# bastion audit system, not in request JSON.
IM_V2_OPERATOR_REPLAY_PRINCIPAL=oncall-primary

# Disabling an account revokes every active device credential. Keep this
# independent credential and principal in a more restricted secret scope than
# routine durable-work replay or user-shard maintenance.
IM_V2_OPERATOR_ACCOUNT_DISABLE_BEARER_TOKEN_BASE64=replace-with-separate-random-32-byte-or-longer-base64
IM_V2_OPERATOR_ACCOUNT_DISABLE_PRINCIPAL=account-safety-primary

# Required by the single-user migration copy/verify endpoint. This mapping is
# deployment-only: never place it in request bodies, logs or durable routes.
IM_V2_USER_SHARD_STORES_JSON=[{"bucket":"users-primary","database_url":"postgres://v2:replace@postgres/im_v2","schema":"im_v2"},{"bucket":"users-next","database_url":"postgres://v2:replace@postgres-next/im_v2","schema":"im_v2"}]

# Sources for personal-event and forward-work replay. The request selects only
# a configured shard_id; missing or unknown owners never fall back to control.
IM_V2_ROOM_SHARD_STORES_JSON=[{"shard_id":"room-a","database_url":"postgres://v2:replace@postgres-rooms/im_v2","schema":"im_v2"}]

# For a deployment using Policy Owner, supply this Operator's caller-only actor
# document with the shared policyPlacement, explicit policyMutation permission,
# pinned owner services, signing identity and mTLS files. A legacy caller is
# refused when the control database already has an active policy deployment.
# IMV2_ROOM_ACTOR_CONFIGURATION_FILE=/secure/imv2/operator/room-actors.json
