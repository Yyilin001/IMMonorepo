# Do not put real credentials in this file. Supply all secrets through the
# deployment secret manager/environment.
IM_V2_DATABASE_URL=postgres://v2_gateway:REPLACE_ME@postgres:5432/im_v2
# Per event loop. Size against foreground command/sync concurrency plus
# durable workers, while keeping the aggregate below the PostgreSQL budget.
IM_V2_DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=8
IM_V2_TLS_HOST=0.0.0.0
IM_V2_TLS_PORT=7443
IM_V2_TLS_CERTIFICATE_CHAIN_PATH=/run/secrets/im_v2_tls_chain.pem
IM_V2_TLS_PRIVATE_KEY_PATH=/run/secrets/im_v2_tls_key.pem
IM_V2_ACCESS_TOKEN_HMAC_KEY_BASE64=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
IM_V2_CAPABILITY_PROFILE=base

IM_V2_MAX_MESSAGE_UTF8_BYTES=4096
IM_V2_MAX_FRAME_BYTES=65536
IM_V2_MAX_PROTOBUF_MESSAGE_DEPTH=32
IM_V2_MAX_IN_FLIGHT_REQUESTS=32
IM_V2_MAX_QUEUED_INBOUND_BYTES=262144
IM_V2_IDLE_TIMEOUT_MS=60000
IM_V2_WORKER_BATCH_SIZE=256
IM_V2_WORKER_POLL_INTERVAL_MS=100
# One PostgreSQL transaction commits this many co-located inbox/sequence/log
# effects. Keep it in the bounded 1...128 range; 128 is the tuned baseline.
IM_V2_FANOUT_DELIVERY_COMMIT_BATCH_SIZE=128
# A remote user shard commits its target transaction and authoritative control
# acknowledgement separately. 256 reduces those cross-database boundaries;
# it does not change the co-located 128-target transaction above.
IM_V2_CROSS_STORE_FANOUT_DELIVERY_COMMIT_BATCH_SIZE=256
# At most two already-claimed remote batches may overlap their independent
# target/control transactions. This is not additional claim-worker parallelism.
IM_V2_CROSS_STORE_FANOUT_DELIVERY_COMMIT_CONCURRENCY=2
# Maximum leases claimed by one delivery worker pass. This is independent of
# the generic worker batch; 2000 is the validated local baseline.
IM_V2_FANOUT_DELIVERY_CLAIM_BATCH_SIZE=2000
# Reserve one claim pass for due retries/expired leases after this many
# fast-path new-delivery passes. Lower values improve recovery latency; higher
# values favor a continuously busy fresh-message stream.
IM_V2_FANOUT_FRESH_BURST_PASSES=7
# Durable worker failure policy. Exhaustion moves work to the alertable paused
# state; it never skips a target or completes the source outbox.
IM_V2_DURABLE_RETRY_INITIAL_DELAY_MS=1000
IM_V2_DURABLE_RETRY_MAX_DELAY_MS=60000
IM_V2_DURABLE_RETRY_MAX_ATTEMPTS=10
IM_V2_DURABLE_RETRY_JITTER_PERCENT=20
# Optional best-effort Core NATS wake hints. Omit all three variables to use
# PostgreSQL durable polling only. Hints never decide delivery completion and
# this minimal adapter does not provide NATS TLS, NKey, broker ACK or health
# semantics; do not enable it as a correctness dependency.
# IM_V2_NATS_URL=nats://nats.internal:4222
# IM_V2_NATS_SUBJECT=imv2.fanout.wake
# IM_V2_NATS_TOKEN=replace-with-broker-token
# Optional Hybrid-group foreground wake routing. In a multi-Gateway deployment
# configure all four values on every replica. The routing key is a distinct
# base64-encoded secret of at least 32 random bytes; it derives opaque broker
# subjects so room IDs never enter NATS subject names. The broker carries only
# room waterlines; PostgreSQL cursor pulls remain the delivery authority.
# IM_V2_GROUP_WAKE_NATS_URL=nats://nats.internal:4222
# IM_V2_GROUP_WAKE_NATS_SUBJECT_PREFIX=imv2.group.wake
# IM_V2_GROUP_WAKE_NATS_TOKEN=replace-with-broker-token
# IM_V2_GROUP_WAKE_ROUTING_KEY_BASE64=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
# Low-frequency maintenance must not run at the real-time fan-out poll rate.
IM_V2_MAINTENANCE_POLL_INTERVAL_MS=60000
# Metadata becomes expired and a provider-cleanup task is queued after this
# many seconds when every reference has been withdrawn.
IM_V2_MEDIA_WITHDRAWN_RETENTION_SECONDS=2592000
# Loopback only. Run the metrics collector in the same host/pod namespace.
IM_V2_METRICS_HOST=127.0.0.1
IM_V2_METRICS_PORT=9464
# Bounded deployment identifier: unique among concurrently running gateway
# processes and reused on restart of the same logical replica. A previously
# unseen ID starts its revocation cursor at the pre-listener current watermark.
IM_V2_GATEWAY_NODE_ID=replace-with-unique-stable-replica-id
# Explicit number of concurrently deployed gateway replicas. Keep this at 1
# only for a true single-gateway deployment. Values above 1 require the Hybrid
# group-wake NATS configuration above; startup otherwise fails closed.
IM_V2_GATEWAY_REPLICA_COUNT=1
IM_V2_USER_SHARD_BUCKET=users-primary
IM_V2_USER_SHARD_ROUTER_EPOCH=1
IM_V2_DIRECT_ROOM_SHARD_ID=rooms-primary
IM_V2_GROUP_ROOM_SHARD_ID=rooms-primary
IM_V2_STRANGER_MESSAGE_MAX_PER_WINDOW=3
IM_V2_STRANGER_MESSAGE_WINDOW_SECONDS=86400

IM_V2_CAPACITY_PROFILE_ID=standard
IM_V2_MAX_ELIGIBLE_MEMBERS=100000
IM_V2_MAX_COMMANDS_PER_WINDOW=1000
IM_V2_MAX_FANOUT_UNITS_PER_WINDOW=100000
IM_V2_MAX_OUTSTANDING_FANOUT_UNITS=1000000
IM_V2_MAX_OUTSTANDING_PLANS=10000
IM_V2_MAX_ENUMERATION_PAGE_SIZE=1000
IM_V2_MAX_PLANNER_CONCURRENCY=8
# Co-located PostgreSQL user shards cap one physical bucket at eight concurrent
# claim passes; larger process-wide values cannot increase that bucket's work.
IM_V2_MAX_DELIVERY_CONCURRENCY=8
IM_V2_RATE_LIMIT_RETRY_AFTER_SECONDS=3
