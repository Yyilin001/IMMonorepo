# Do not put real credentials in this file. Supply all secrets through the
# deployment secret manager/environment.
IM_V2_DATABASE_URL=postgres://v2_gateway:REPLACE_ME@postgres:5432/im_v2
# 消息写入使用 4 个数据库 EventLoop，每个 2 条连接，每节点共 8 条。
IM_V2_DATABASE_EVENT_LOOP_THREADS=4
# Optional: keep non-message/control pools on fewer EventLoops while spreading message writes.
# Omitted uses all EventLoops; capacities below are per active pool EventLoop.
# IM_V2_DATABASE_NON_MESSAGE_POOL_EVENT_LOOP_THREADS=4
# 各工作类别的每 EventLoop 连接预算之和必须不超过此上限。
IM_V2_DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=9
IM_V2_DATABASE_MESSAGE_WRITE_CONNECTIONS_PER_EVENT_LOOP=2
# 每条物理写连接最多两个普通消息 SQL 周期在途，各自 Sync 提交；1 可关闭流水线。
IM_V2_DATABASE_MESSAGE_WRITE_PIPELINE_DEPTH=2
# 同主机部署可显式将指定数据库的消息写池改为 Unix socket。
# 映射键必须是现有完整数据库 URL，其他连接池与分片身份仍使用原 URL。
# IM_V2_DATABASE_MESSAGE_WRITE_UNIX_SOCKETS_JSON={"postgres://v2_gateway:REPLACE_ME@postgres:5432/im_v2":"/run/postgresql/.s.PGSQL.5432"}
IM_V2_DATABASE_FOREGROUND_CONNECTIONS_PER_EVENT_LOOP=2
# Optional independent policy-control pool; absent follows the foreground pool.
# Counts toward IM_V2_DATABASE_MAX_TOTAL_CONNECTIONS.
# IM_V2_DATABASE_POLICY_CONTROL_CONNECTIONS_PER_EVENT_LOOP=4
IM_V2_DATABASE_SYNC_CONNECTIONS_PER_EVENT_LOOP=1
IM_V2_DATABASE_DELIVERY_CONNECTIONS_PER_EVENT_LOOP=1
IM_V2_DATABASE_PROJECTION_CONNECTIONS_PER_EVENT_LOOP=2
IM_V2_DATABASE_MAINTENANCE_CONNECTIONS_PER_EVENT_LOOP=1
# 持久消息写 Worker 必须使用独立连接池。
IM_V2_DATABASE_WORKLOAD_POOL_ISOLATION_ENABLED=true
# Startup rejects (unique database URLs * event loops * per-loop maximum)
# above this process-local budget, and rejects more logical stores than this.
# Gateway total also includes one personal-event routing connection per event loop on the control database.
IM_V2_DATABASE_MAX_TOTAL_CONNECTIONS=512
IM_V2_MAX_USER_SHARD_STORES=16
IM_V2_DATABASE_CONNECT_TIMEOUT_MS=5000
IM_V2_DATABASE_POOL_TIMEOUT_MS=3000
# Installed through every PostgreSQL connection's startup packet. The server
# then verifies the effective values before opening any listener.
IM_V2_DATABASE_STATEMENT_TIMEOUT_MS=5000
IM_V2_DATABASE_LOCK_TIMEOUT_MS=2000
IM_V2_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
IM_V2_TLS_HOST=0.0.0.0
IM_V2_TLS_PORT=7443
IM_V2_TLS_CERTIFICATE_CHAIN_PATH=/run/secrets/im_v2_tls_chain.pem
IM_V2_TLS_PRIVATE_KEY_PATH=/run/secrets/im_v2_tls_key.pem
IM_V2_ACCESS_TOKEN_HMAC_KEY_BASE64=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
# Shared by Account and every room-hosting Gateway for invitation token identity.
# Supply the same stable secret from deployment secret storage; at least 32 bytes.
IM_V2_GROUP_INVITE_TOKEN_HMAC_KEY_BASE64=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
IM_V2_CAPABILITY_PROFILE=base

IM_V2_MAX_MESSAGE_UTF8_BYTES=4096
IM_V2_MAX_FRAME_BYTES=65536
# v45 message operations use a separate bounded payload allowance; ordinary frames keep the limit above.
IM_V2_MESSAGE_SEND_OPERATIONS_ENABLED=true
# Per-connection and process limits for outstanding message requests.
IM_V2_MESSAGE_SEND_MAX_IN_FLIGHT_PER_CONNECTION=4
IM_V2_MESSAGE_SEND_MAX_IN_FLIGHT_BYTES_PER_CONNECTION=4194304
IM_V2_MESSAGE_SEND_MAX_IN_FLIGHT_BYTES_PROCESS=67108864
IM_V2_MAX_PROTOBUF_MESSAGE_DEPTH=32
IM_V2_MAX_IN_FLIGHT_REQUESTS=32
IM_V2_MAX_CONNECTIONS=10000
# Authenticated leases are enforced both in-process and transactionally across
# gateway replicas before the authenticated response is written.
IM_V2_MAX_CONNECTIONS_PER_DEVICE=2
IM_V2_MAX_CONNECTIONS_PER_USER=8
# Shared per-replica token buckets charge both device and user. The identity
# cache is hard-bounded and must cover two keys per accepted connection.
IM_V2_DEVICE_COMMANDS_PER_SECOND=32
IM_V2_DEVICE_COMMAND_BURST=64
IM_V2_USER_COMMANDS_PER_SECOND=128
IM_V2_USER_COMMAND_BURST=256
IM_V2_RATE_LIMIT_MAX_TRACKED_IDENTITIES=20000
IM_V2_MAX_QUEUED_INBOUND_BYTES=262144
IM_V2_MAX_QUEUED_INBOUND_CHUNKS=512
IM_V2_AUTHENTICATION_TIMEOUT_MS=10000
IM_V2_IDLE_TIMEOUT_MS=60000
IM_V2_WORKER_BATCH_SIZE=256
IM_V2_WORKER_POLL_INTERVAL_MS=100
# Parallel checkpoint claims per unique user schema. `SKIP LOCKED` keeps one
# user's ordered sequence on one worker while allowing different users to run.
# With isolated pools, startup also reserves one snapshot-builder lane per
# schema and aggregates schemas that share the same physical database URL.
IM_V2_USER_PROJECTION_CONCURRENCY=2
# Busy checkpoints drain without the idle poll sleep. A pass-count or wall-time
# budget forces a cooperative yield before the next bounded transaction.
IM_V2_USER_PROJECTION_MAX_CONSECUTIVE_BUSY_PASSES=16
IM_V2_USER_PROJECTION_BUSY_DRAIN_BUDGET_MS=50
# A short bounded queue rejects overload as retryable SERVER_BUSY before the
# longer Fluent pool timeout. Durable writes, interactive reads and Sync have
# independent reservations; their write/read sum must fit the foreground pool.
IM_V2_FOREGROUND_WRITE_DATABASE_WORK_LIMIT=12
IM_V2_INTERACTIVE_READ_DATABASE_WORK_LIMIT=4
IM_V2_SYNC_DATABASE_WORK_LIMIT=4
IM_V2_FOREGROUND_WRITE_DATABASE_WORK_MAX_QUEUED=288
IM_V2_INTERACTIVE_READ_DATABASE_WORK_MAX_QUEUED=96
IM_V2_SYNC_DATABASE_WORK_MAX_QUEUED=128
IM_V2_DATABASE_WORK_ADMISSION_TIMEOUT_MS=200
IM_V2_DATABASE_WORK_ADMISSION_ENABLED=true
# Best-effort availability hints are collapsed to one maximum watermark per
# user. Cursor pull remains authoritative if a bounded pending hint is dropped.
IM_V2_SYNC_WAKE_COALESCING_MS=40
IM_V2_SYNC_WAKE_MAX_PENDING_USERS=50000
IM_V2_SYNC_WAKE_DELIVERY_CONCURRENCY=64
IM_V2_SYNC_WAKE_COALESCING_ENABLED=true
# Metrics remain exact. Fast successful command log lines are sampled. Slow,
# rejected and failed command diagnostics retain a small per-result burst but
# are bounded so an overload cannot amplify itself through synchronous stdout.
IM_V2_LOG_LEVEL=info
# sampled：详细消息链路按操作 UUID 采样 1/64；all：原有全量慢请求诊断。
IM_V2_SEND_PATH_TRACE_MODE=sampled
# 消息写池复用有界预备 SQL 模板；false 可用于同二进制对照。
IM_V2_MESSAGE_WRITE_PREPARED_QUERIES_ENABLED=true
IM_V2_COMMAND_SUCCESS_LOG_SAMPLE_PERMILLE=10
IM_V2_COMMAND_SLOW_LOG_THRESHOLD_MS=250
IM_V2_COMMAND_DIAGNOSTIC_LOG_MAX_PER_SECOND=20
# Unreferenced immutable message revisions remain recoverable for this grace
# period (default 7d), independent of user-projection MVCC retention.
IM_V2_MESSAGE_PROJECTION_STATE_RETENTION_SECONDS=604800
# 房间日志保留：permanent 计入全部历史读者的已读线（默认，不裁剪），
# window 只计入窗口内仍活跃的读者，窗口外读者的未读历史会被裁剪并在返回时
# 被显式标记为"历史不完整"。切换前请阅读房间读模型合同的保留窗口一节。
IM_V2_ROOM_LOG_RETENTION_MODE=permanent
IM_V2_ROOM_LOG_RETENTION_WINDOW_SECONDS=2592000
# Durable worker failure policy. Exhaustion moves work to the alertable paused
# state; it never skips a target or completes the source outbox.
IM_V2_DURABLE_RETRY_INITIAL_DELAY_MS=1000
IM_V2_DURABLE_RETRY_MAX_DELAY_MS=60000
IM_V2_DURABLE_RETRY_MAX_ATTEMPTS=10
IM_V2_DURABLE_RETRY_JITTER_PERCENT=20
# Cross-Gateway room events, personal Sync, presence and typing use authenticated
# DistributedCluster callbacks. Generate and mount the per-process identity,
# private CA, signing key and explicit room/user owner permissions before start.
# A distinct stable gateway node ID is required for every concurrent replica.
IMV2_ROOM_ACTOR_CONFIGURATION_FILE=/run/im-v2-room-actor/configuration.json
# Account-wide online delivery requires actor routing, including one Gateway.
# Logs and device cursors provide durable recovery.
# Low-frequency maintenance must not run at the real-time fan-out poll rate.
IM_V2_MAINTENANCE_POLL_INTERVAL_MS=60000
# Terminal fan-out bookkeeping and Sync Log prefixes can accumulate at message
# rate, so they drain independently. Busy passes run immediately but yield at
# either budget; an empty database falls back to the idle poll interval.
IM_V2_BACKLOG_MAINTENANCE_IDLE_POLL_INTERVAL_MS=1000
IM_V2_BACKLOG_MAINTENANCE_MAX_CONSECUTIVE_BUSY_PASSES=4
IM_V2_BACKLOG_MAINTENANCE_BUSY_DRAIN_BUDGET_MS=100
# Metadata becomes expired and a provider-cleanup task is queued after this
# many seconds when every reference has been withdrawn.
IM_V2_MEDIA_WITHDRAWN_RETENTION_SECONDS=2592000
# First-party clients stop replay after 30 days. Keep server results at least
# 35 days; 45 days leaves an explicit clock-skew/maintenance safety margin.
IM_V2_IDEMPOTENCY_RETENTION_SECONDS=3888000
# Loopback only. Run the metrics collector in the same host/pod namespace.
IM_V2_METRICS_HOST=127.0.0.1
IM_V2_METRICS_PORT=9464
# Exact durable backlog aggregates are shared across scrapes and run at most
# once per this interval. Keep it at least as large as the refresh timeout.
IM_V2_METRICS_MINIMUM_REFRESH_INTERVAL_MS=30000
# Returns a stale/unavailable aggregate before the database statement timeout;
# one stuck refresh cannot retain every future metrics request.
IM_V2_METRICS_REFRESH_TIMEOUT_MS=4000
# Bounded deployment identifier: unique among concurrently running gateway
# processes and reused on restart of the same logical replica. A previously
# unseen ID starts its revocation cursor at the pre-listener current watermark.
IM_V2_GATEWAY_NODE_ID=replace-with-unique-stable-replica-id
# Explicit number of concurrently deployed gateway replicas. Keep this at 1
# only for a true single-gateway deployment. Multiple replicas require Actor
# routing and distinct authenticated identities; startup otherwise fails closed.
IM_V2_GATEWAY_REPLICA_COUNT=1
IM_V2_USER_SHARD_BUCKET=users-primary
IM_V2_USER_SHARD_ROUTER_EPOCH=1
# One ID preserves the single-pool topology. A comma-separated list selects a
# stable pool for each unordered user pair, e.g. rooms-00,rooms-01,... . Every
# listed pool must already have a live lease for the configured capacity profile.
IM_V2_DIRECT_ROOM_SHARD_ID=rooms-primary
IM_V2_GROUP_ROOM_SHARD_ID=rooms-primary
IM_V2_STRANGER_MESSAGE_MAX_PER_WINDOW=3
IM_V2_STRANGER_MESSAGE_WINDOW_SECONDS=86400
# `disabled` stops both new durable review jobs and the review worker. Existing
# jobs remain untouched, and messages accepted while disabled are not backfilled.
IM_V2_CONTENT_REVIEW_MODE=enabled
# When the mode is `enabled`, omitting the safety actor leaves only the worker
# disabled while jobs remain durable for later processing. The actor is a
# server-owned regular account used only in moderation audit rows; it has no
# device credential. These comma-separated terms are a local/rule baseline,
# not a substitute for a production AI/OCR/media-review adapter.
# IM_V2_CONTENT_REVIEW_SAFETY_ACTOR_USER_ID=REPLACE_WITH_SAFETY_AUDIT_USER_UUID
# IM_V2_CONTENT_REVIEW_VIOLATION_TERMS=term_one,term_two
# IM_V2_CONTENT_REVIEW_ESCALATION_TERMS=term_for_human_review

IM_V2_CAPACITY_PROFILE_ID=standard
IM_V2_MAX_ELIGIBLE_MEMBERS=100000
IM_V2_MAX_COMMANDS_PER_WINDOW=1000
# Co-located PostgreSQL user shards cap one physical bucket at eight concurrent
# claim passes; larger process-wide values cannot increase that bucket's work.
IM_V2_RATE_LIMIT_RETRY_AFTER_SECONDS=3

# Requires upgraded Actor peers; diagnostic default remains disabled.
IM_V2_ACTOR_BINARY_INVOCATIONS_ENABLED=false
