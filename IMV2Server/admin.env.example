# 独立管理服务，固定只绑定 127.0.0.1；生产通过同域 HTTPS 反向代理访问。
IM_V2_ADMIN_PORT=9446
IM_V2_ADMIN_ACCOUNT_ORIGIN=https://accounts.example.com
IM_V2_ADMIN_GATEWAY_HOST=gateway.example.com
IM_V2_ADMIN_GATEWAY_PORT=7443
IM_V2_ADMIN_ORIGIN=https://admin.example.com
# JSON 文件由部署密钥管理提供；每条记录包含 username、passwordHash、role。
IM_V2_ADMIN_ACCOUNTS_FILE=/secure/imv2/admin/accounts.json
IM_V2_DATABASE_URL=postgres://im_v2:change-me@127.0.0.1:5432/im_v2
IM_V2_DATABASE_EVENT_LOOP_THREADS=2
IM_V2_DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=4
IM_V2_DATABASE_MAX_TOTAL_CONNECTIONS=32
IM_V2_MAX_USER_SHARD_STORES=16
IM_V2_DATABASE_CONNECT_TIMEOUT_MS=5000
IM_V2_DATABASE_POOL_TIMEOUT_MS=3000
IM_V2_DATABASE_STATEMENT_TIMEOUT_MS=5000
IM_V2_DATABASE_LOCK_TIMEOUT_MS=3000
IM_V2_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
IM_V2_ROOM_SHARD_STORES_JSON=[{"shard_id":"room-a","database_url":"postgres://im_v2:change-me@127.0.0.1:5432/im_v2","schema":"im_v2"}]
# 管理服务使用独立的 caller-only Actor 身份，拥有 policyMutation 权限。
IMV2_ROOM_ACTOR_CONFIGURATION_FILE=/secure/imv2/admin/room-actors.json
