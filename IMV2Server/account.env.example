# This service listens only on loopback. Put a managed HTTPS reverse proxy with
# account-factor rate limits in front of it; do not publish this port directly.
IM_V2_DATABASE_URL=postgres://im_v2:change-me@127.0.0.1:5432/im_v2
IM_V2_DATABASE_EVENT_LOOP_THREADS=2
IM_V2_DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=4
IM_V2_DATABASE_MAX_TOTAL_CONNECTIONS=16
IM_V2_MAX_USER_SHARD_STORES=1
IM_V2_DATABASE_CONNECT_TIMEOUT_MS=5000
IM_V2_DATABASE_POOL_TIMEOUT_MS=3000
IM_V2_DATABASE_STATEMENT_TIMEOUT_MS=5000
IM_V2_DATABASE_LOCK_TIMEOUT_MS=2000
IM_V2_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
IM_V2_ACCOUNT_LISTEN_HOST=127.0.0.1
IM_V2_ACCOUNT_LISTEN_PORT=8444
IM_V2_ACCESS_TOKEN_HMAC_KEY_BASE64=replace-with-random-32-byte-or-longer-base64
IM_V2_CREDENTIAL_REPLAY_ENVELOPE_KEY_BASE64=replace-with-random-32-byte-base64
# Encrypts the opaque APNs endpoint at rest. It belongs only to the account
# service and the explicitly enabled Push provider worker, never to clients.
IM_V2_PUSH_ENDPOINT_ENVELOPE_KEY_BASE64=replace-with-random-32-byte-base64
# Shared only with the managed HTTPS edge. That edge replaces any
# client-supplied forwarding headers and injects this proof before connecting
# to the loopback account listener.
IM_V2_ACCOUNT_EDGE_AUTHORIZATION_SECRET_BASE64=replace-with-random-32-byte-base64
# Derives the only persisted form of the HTTPS-edge client address. Use a
# distinct 32-byte-or-longer key; PostgreSQL stores only a keyed HMAC digest.
IM_V2_ACCOUNT_CLIENT_RATE_LIMIT_HMAC_KEY_BASE64=replace-with-random-32-byte-or-longer-base64
IM_V2_ACCOUNT_ASSERTION_HMAC_KEY_BASE64=replace-with-random-32-byte-or-longer-base64
# Generate once with the same bcrypt cost used by Vapor (normally 12). This is
# not a password and does not need to be secret, but it must be a valid hash.
IM_V2_PASSWORD_DUMMY_BCRYPT_HASH='$2b$12$replace-with-a-valid-60-character-bcrypt-hash'
# Per-account-handle failure protection stored in PostgreSQL across all account
# service replicas. The public HTTPS edge must additionally rate-limit trusted
# client/IP traffic before forwarding to this loopback listener.
IM_V2_PASSWORD_LOGIN_MAX_FAILURES=5
IM_V2_PASSWORD_LOGIN_WINDOW_SECONDS=900
IM_V2_PASSWORD_LOGIN_LOCKOUT_SECONDS=900
# Cross-replica request budget applied before every account route after the
# edge proof and edge-derived client address are validated. Pick approved
# values for the actual ingress topology; these local values are not a claim
# of production capacity or abuse policy.
IM_V2_ACCOUNT_CLIENT_RATE_LIMIT_MAX_REQUESTS=60
IM_V2_ACCOUNT_CLIENT_RATE_LIMIT_WINDOW_SECONDS=60
# Authenticated exact-@handle lookup budget. The public HTTPS edge must also
# rate-limit trusted client/IP traffic before forwarding to this service.
IM_V2_PUBLIC_IDENTITY_LOOKUP_MAX_QUERIES=30
IM_V2_PUBLIC_IDENTITY_LOOKUP_WINDOW_SECONDS=60
