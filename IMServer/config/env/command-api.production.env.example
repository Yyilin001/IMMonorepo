APP_ENV=production
IM_NODE_ID=command-api-1
JWT_SECRETS=active:replace-me
JWT_ACTIVE_KID=active
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
IM_ADMIN_API_ENABLED=false
# Required only when IM_ADMIN_API_ENABLED=true. Keep this different from IM_INTERNAL_SHARED_SECRET.
# IM_ADMIN_SHARED_SECRET=replace-with-strong-admin-secret

REDIS_URL=redis://user:pass@redis-cluster.example:6379
IM_METRICS_ENABLED=true
IM_HOT_CONVERSATION_MSG_PER_SECOND_LIMIT=200
IM_SEQUENCE_ALLOCATION_MODE=block
IM_SEQUENCE_BLOCK_SIZE=256
IM_GROUP_MEMBER_LIMIT=1000
IM_TIMELINE_READ_VISIBILITY_SCAN_MAX_ROWS=5000
IM_TIMELINE_READ_VISIBILITY_SCAN_MAX_PAGES=50
# Production preflight requires both timeline/since hot and recent caches to
# stay enabled so large-group catch-up does not fall back to database reads.
IM_TIMELINE_SINCE_HOT_CACHE_TTL_MS=250
IM_TIMELINE_SINCE_HOT_CACHE_MAX_ENTRIES=4096
IM_TIMELINE_SINCE_RECENT_CACHE_TTL_MS=2000
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_CONVERSATIONS=1024
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_ITEMS_PER_CONVERSATION=512
IM_TIMELINE_SINCE_TARGET_SEQUENCE_COALESCE_WINDOW_MS=5
IM_TIMELINE_SINCE_CACHE_INVALIDATION_MODE=redis
IM_TIMELINE_SINCE_CACHE_INVALIDATION_REDIS_MAX_CONNECTIONS=2
IM_COMMAND_NODE_ID=node-a
IM_COMMAND_NODE_URLS=node-a=http://command-api-a.internal:8081,node-b=http://command-api-b.internal:8081
IM_COMMAND_INTERNAL_SHARED_SECRET=replace-me
IM_CONVERSATION_MEMBER_CACHE_TTL_SECONDS=300
IM_MESSAGE_WRITE_BATCH_ENABLED=true
IM_MESSAGE_WRITE_BATCH_MAX_SIZE=32
IM_MESSAGE_WRITE_BATCH_MAX_DELAY_MS=10
IM_MESSAGE_CREATED_RECIPIENT_INLINE_THRESHOLD=500
IM_DOMAIN_EVENT_RECIPIENT_SNAPSHOT_DEDUP_THRESHOLD=500
IM_CLEANUP_ENABLED=true
IM_CLEANUP_INTERVAL_SECONDS=86400
IM_CLEANUP_RECIPIENT_SET_RETENTION_DAYS=30
IM_CLEANUP_RECIPIENT_SET_BATCH_SIZE=1000
IM_CONSISTENCY_REPAIR_ENABLED=false

MEDIA_STORAGE_PROVIDER=s3compatible
MEDIA_STORAGE_S3_ENDPOINT=https://s3.internal
MEDIA_STORAGE_S3_BUCKET=im-media
MEDIA_STORAGE_S3_ACCESS_KEY_ID=replace-me
MEDIA_STORAGE_S3_SECRET_ACCESS_KEY=replace-me
MEDIA_STORAGE_S3_REGION=us-east-1
MEDIA_STORAGE_S3_FORCE_PATH_STYLE=true

DATABASE_PRIMARY_HOST=pg-primary.example
DATABASE_PRIMARY_PORT=5432
DATABASE_PRIMARY_USERNAME=im_app
DATABASE_PRIMARY_PASSWORD=replace-me
DATABASE_PRIMARY_NAME=im_primary

DATABASE_REPLICA_HOST=pg-replica.example
DATABASE_REPLICA_PORT=5432
DATABASE_REPLICA_USERNAME=im_app
DATABASE_REPLICA_PASSWORD=replace-me
DATABASE_REPLICA_NAME=im_primary

IM_CONVERSATION_SHARD_IDS=shard-0
DATABASE_CONVERSATION_SHARD_0_HOST=pg-conversation-shard-0.example
DATABASE_CONVERSATION_SHARD_0_PORT=5432
DATABASE_CONVERSATION_SHARD_0_USERNAME=im_app
DATABASE_CONVERSATION_SHARD_0_PASSWORD=replace-me
DATABASE_CONVERSATION_SHARD_0_NAME=im_conversation_shard_0
# DATABASE_CONVERSATION_SHARD_0_REPLICA_HOST=pg-conversation-shard-0-replica.example
# DATABASE_CONVERSATION_SHARD_0_REPLICA_PORT=5432
# DATABASE_CONVERSATION_SHARD_0_REPLICA_USERNAME=im_app
# DATABASE_CONVERSATION_SHARD_0_REPLICA_PASSWORD=replace-me
# DATABASE_CONVERSATION_SHARD_0_REPLICA_NAME=im_conversation_shard_0

IM_GATEWAY_RELAY_MODE=http
IM_GATEWAY_INTERNAL_BASE_URL=http://gateway-internal.example:8080
IM_INTERNAL_SHARED_SECRET=replace-me

IM_EVENT_STREAM_DRIVER=kafka
IM_KAFKA_BROKERS=kafka-a.example:9092,kafka-b.example:9092,kafka-c.example:9092
IM_KAFKA_TOPIC=conversation-domain-events
IM_KAFKA_DEAD_LETTER_TOPIC=conversation-domain-events-dead-letter
IM_KAFKA_CLIENT_ID=im-command-api
IM_KAFKA_REQUIRED_ACKS=all
IM_KAFKA_COMPRESSION=snappy
IM_KAFKA_LINGER_MS=5
IM_KAFKA_REQUEST_TIMEOUT_MS=30000
IM_KAFKA_MESSAGE_TIMEOUT_MS=300000
IM_KAFKA_POLL_INTERVAL_MS=20
IM_KAFKA_FLUSH_TIMEOUT_MS=10000
IM_KAFKA_AUTO_CREATE_TOPICS=false
IM_KAFKA_SECURITY_PROTOCOL=sasl_tls
IM_KAFKA_SASL_MECHANISM=scram-sha-512
IM_KAFKA_SASL_USERNAME=im_kafka_user
IM_KAFKA_SASL_PASSWORD=replace-me
IM_KAFKA_TLS_CA_FILE=/run/secrets/kafka-ca.pem
IM_OUTBOX_NOTIFY_ENABLED=false
IM_OUTBOX_NOTIFY_CHANNEL=im_conversation_outbox
