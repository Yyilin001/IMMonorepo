APP_ENV=production
IM_NODE_ID=query-api-1
JWT_SECRETS=active:replace-me
JWT_ACTIVE_KID=active
AUTH_ACCESS_TOKEN_TTL_SECONDS=600

REDIS_URL=redis://user:pass@redis-cluster.example:6379
IM_METRICS_ENABLED=true
IM_TIMELINE_READ_VISIBILITY_SCAN_MAX_ROWS=5000
IM_TIMELINE_READ_VISIBILITY_SCAN_MAX_PAGES=50
# Short in-process cache for hot large-group timeline/since catch-up after
# lightweight realtime hints. Keep TTL below the client hint catch-up throttle
# so stale empty pages self-heal on the next scheduled pull. Production
# preflight requires both hot and recent caches to stay enabled.
IM_TIMELINE_SINCE_HOT_CACHE_TTL_MS=250
IM_TIMELINE_SINCE_HOT_CACHE_MAX_ENTRIES=4096
IM_TIMELINE_SINCE_RECENT_CACHE_TTL_MS=2000
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_CONVERSATIONS=1024
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_ITEMS_PER_CONVERSATION=512
IM_TIMELINE_SINCE_TARGET_SEQUENCE_COALESCE_WINDOW_MS=5
IM_TIMELINE_SINCE_CACHE_INVALIDATION_MODE=redis
IM_TIMELINE_SINCE_CACHE_INVALIDATION_REDIS_MAX_CONNECTIONS=2

DATABASE_PRIMARY_HOST=pg-primary.example
DATABASE_PRIMARY_PORT=5432
DATABASE_PRIMARY_USERNAME=im_app
DATABASE_PRIMARY_PASSWORD=replace-me
DATABASE_PRIMARY_NAME=im_primary

DATABASE_REPLICA_HOST=pg-replica.example
DATABASE_REPLICA_PORT=5432
DATABASE_REPLICA_USERNAME=im_app
DATABASE_REPLICA_PASSWORD=replace-me
DATABASE_REPLICA_NAME=im_primary

IM_CONVERSATION_SHARD_IDS=shard-0
DATABASE_CONVERSATION_SHARD_0_HOST=pg-conversation-shard-0.example
DATABASE_CONVERSATION_SHARD_0_PORT=5432
DATABASE_CONVERSATION_SHARD_0_USERNAME=im_app
DATABASE_CONVERSATION_SHARD_0_PASSWORD=replace-me
DATABASE_CONVERSATION_SHARD_0_NAME=im_conversation_shard_0
DATABASE_CONVERSATION_SHARD_0_REPLICA_HOST=pg-conversation-shard-0-replica.example
DATABASE_CONVERSATION_SHARD_0_REPLICA_PORT=5432
DATABASE_CONVERSATION_SHARD_0_REPLICA_USERNAME=im_app
DATABASE_CONVERSATION_SHARD_0_REPLICA_PASSWORD=replace-me
DATABASE_CONVERSATION_SHARD_0_REPLICA_NAME=im_conversation_shard_0

IM_SUMMARY_SHARD_IDS=summary-a,summary-b
DATABASE_SUMMARY_SUMMARY_A_HOST=pg-summary-a.example
DATABASE_SUMMARY_SUMMARY_A_PORT=5432
DATABASE_SUMMARY_SUMMARY_A_USERNAME=im_summary
DATABASE_SUMMARY_SUMMARY_A_PASSWORD=replace-me
DATABASE_SUMMARY_SUMMARY_A_NAME=im_summary_a
DATABASE_SUMMARY_SUMMARY_B_HOST=pg-summary-b.example
DATABASE_SUMMARY_SUMMARY_B_PORT=5432
DATABASE_SUMMARY_SUMMARY_B_USERNAME=im_summary
DATABASE_SUMMARY_SUMMARY_B_PASSWORD=replace-me
DATABASE_SUMMARY_SUMMARY_B_NAME=im_summary_b

IM_SUMMARY_QUERY_READ_SOURCE=sharded
IM_SUMMARY_RESPONSE_MEMBER_USER_IDS_LIMIT=500

# Use database search for small/medium deployments. Switch to opensearch only
# after provisioning OpenSearch and deploying search-index-consumer capacity.
IM_SEARCH_DRIVER=database
# IM_SEARCH_DRIVER=opensearch
# IM_OPENSEARCH_ENDPOINT=https://opensearch.internal
IM_OPENSEARCH_INDEX=conversation-message-search
