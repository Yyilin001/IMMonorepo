APP_ENV=production
IM_NODE_ID=stream-consumer-1
IM_METRICS_ENABLED=true
IM_GROUP_MEMBER_LIMIT=1000
# Stream consumers publish distributed timeline/since cache invalidations for
# query-api shared caches after timeline-notice and message side effects.
# Production preflight requires both hot and recent caches to stay enabled.
IM_TIMELINE_SINCE_HOT_CACHE_TTL_MS=250
IM_TIMELINE_SINCE_HOT_CACHE_MAX_ENTRIES=4096
IM_TIMELINE_SINCE_RECENT_CACHE_TTL_MS=2000
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_CONVERSATIONS=1024
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_ITEMS_PER_CONVERSATION=512
IM_TIMELINE_SINCE_TARGET_SEQUENCE_COALESCE_WINDOW_MS=5
IM_TIMELINE_SINCE_CACHE_INVALIDATION_MODE=redis
IM_TIMELINE_SINCE_CACHE_INVALIDATION_REDIS_MAX_CONNECTIONS=2
IM_CONSISTENCY_REPAIR_ENABLED=false
IM_CONSISTENCY_REPAIR_INTERVAL_MS=30000
IM_CONSISTENCY_REPAIR_BATCH_SIZE=200

# Required when IM_STREAM_CONSUMER_GROUPS=realtime-delivery-consumer. The
# consumer reads active conversation presence to split active full-message
# recipients from inactive conversation-list hints before gateway relay.
IM_ROUTING_MODE=redis
REDIS_URL=redis://user:pass@redis-primary.internal:6379
IM_REDIS_DEPLOYMENT_TOPOLOGY=standalone
IM_REDIS_MAX_CONNECTIONS=16
IM_REDIS_PRESENCE_HEARTBEAT_TIMEOUT_SECONDS=90
IM_REDIS_ACTIVE_CONVERSATION_ROUTE_TTL_SECONDS=900
# Short in-process cache for active conversation user-set snapshots and
# user->node active route lookups. Keep low so conversation presence changes
# propagate quickly while hot groups avoid repeated Redis active_users scans.
IM_REDIS_ACTIVE_CONVERSATION_ROUTE_CACHE_TTL_SECONDS=2

DATABASE_PRIMARY_HOST=pg-primary.example
DATABASE_PRIMARY_PORT=5432
DATABASE_PRIMARY_USERNAME=im_app
DATABASE_PRIMARY_PASSWORD=replace-me
DATABASE_PRIMARY_NAME=im_primary

DATABASE_REPLICA_HOST=pg-replica.example
DATABASE_REPLICA_PORT=5432
DATABASE_REPLICA_USERNAME=im_app
DATABASE_REPLICA_PASSWORD=replace-me
DATABASE_REPLICA_NAME=im_primary

IM_CONVERSATION_SHARD_IDS=shard-0
DATABASE_CONVERSATION_SHARD_0_HOST=pg-conversation-shard-0.example
DATABASE_CONVERSATION_SHARD_0_PORT=5432
DATABASE_CONVERSATION_SHARD_0_USERNAME=im_app
DATABASE_CONVERSATION_SHARD_0_PASSWORD=replace-me
DATABASE_CONVERSATION_SHARD_0_NAME=im_conversation_shard_0

IM_SUMMARY_SHARD_IDS=summary-a,summary-b
DATABASE_SUMMARY_SUMMARY_A_HOST=pg-summary-a.example
DATABASE_SUMMARY_SUMMARY_A_PORT=5432
DATABASE_SUMMARY_SUMMARY_A_USERNAME=im_summary
DATABASE_SUMMARY_SUMMARY_A_PASSWORD=replace-me
DATABASE_SUMMARY_SUMMARY_A_NAME=im_summary_a
DATABASE_SUMMARY_SUMMARY_B_HOST=pg-summary-b.example
DATABASE_SUMMARY_SUMMARY_B_PORT=5432
DATABASE_SUMMARY_SUMMARY_B_USERNAME=im_summary
DATABASE_SUMMARY_SUMMARY_B_PASSWORD=replace-me
DATABASE_SUMMARY_SUMMARY_B_NAME=im_summary_b

IM_SUMMARY_PROJECTION_WRITE_MODE=sharded
# Must be <= IM_DOMAIN_DELIVERY_MESSAGE_CREATED_OWNER_DELIVERY_SKIP_RECIPIENT_THRESHOLD
# when summary-projection-consumer and domain-delivery-consumer are both enabled
# in the same deployment window, so every skip-owner-delivery group also uses
# activity-only summary projection instead of per-owner summary/change-log writes.
IM_SUMMARY_PROJECTION_MESSAGE_CREATED_ACTIVITY_ONLY_RECIPIENT_THRESHOLD=500
# Coalesces hot large-group ConversationActivitySummary writes by conversation.
# This is a read-model freshness window; clients still catch up from timeline.
# Production preflight bounds this to 50...1000ms.
IM_SUMMARY_PROJECTION_ACTIVITY_COALESCE_WINDOW_MS=500
# Realtime summary payloads also use this cap for membership/settings events.
# Large groups keep member_count accurate and fetch members through paged APIs.
IM_SUMMARY_RESPONSE_MEMBER_USER_IDS_LIMIT=500

IM_EVENT_STREAM_DRIVER=kafka
IM_KAFKA_BROKERS=kafka-a.example:9092,kafka-b.example:9092,kafka-c.example:9092
IM_KAFKA_TOPIC=conversation-domain-events
IM_KAFKA_DEAD_LETTER_TOPIC=conversation-domain-events-dead-letter
IM_KAFKA_CLIENT_ID=im-stream-consumer
IM_KAFKA_REQUIRED_ACKS=all
IM_KAFKA_COMPRESSION=snappy
IM_KAFKA_LINGER_MS=5
IM_KAFKA_REQUEST_TIMEOUT_MS=30000
IM_KAFKA_MESSAGE_TIMEOUT_MS=300000
IM_KAFKA_POLL_INTERVAL_MS=20
IM_KAFKA_FLUSH_TIMEOUT_MS=10000
IM_KAFKA_AUTO_CREATE_TOPICS=false
IM_KAFKA_SECURITY_PROTOCOL=sasl_tls
IM_KAFKA_SASL_MECHANISM=scram-sha-512
IM_KAFKA_SASL_USERNAME=im_kafka_user
IM_KAFKA_SASL_PASSWORD=replace-me
IM_KAFKA_TLS_CA_FILE=/run/secrets/kafka-ca.pem

IM_STREAM_CONSUMER_GROUPS=summary-projection-consumer
# Bounded in-process queue between Kafka polling and event processing. The
# processor only coalesces contiguous same-partition message_created runs.
# Keep run batch > 1, and queue capacity >= run batch size, so large-group
# message_created runs can be coalesced instead of processed one-by-one.
# Batch-fill wait adds a small delay after the first queued message so adjacent
# Kafka messages can enter the same processing run. Keep this low; production
# validation rejects values above 100ms.
IM_STREAM_CONSUMER_QUEUE_CAPACITY=512
IM_STREAM_CONSUMER_RUN_BATCH_SIZE=32
IM_STREAM_CONSUMER_BATCH_FILL_WAIT_MS=10
# Production consumers must fail omitted-recipient message_created events that
# are missing their command-side recipient snapshot. This prevents repeated
# membership expansion in summary/domain/realtime/notification consumers and
# makes malformed events retry/dead-letter instead of silently scanning members.
IM_STREAM_CONSUMER_REQUIRE_MESSAGE_CREATED_RECIPIENT_SNAPSHOT=true
# Deploy one stream-consumer process per group:
# summary-projection-consumer
# realtime-delivery-consumer
# domain-delivery-consumer
# changes-log-consumer
# search-index-consumer
# notification-consumer
# repair-replay-consumer

# Required when IM_STREAM_CONSUMER_GROUPS is domain-delivery-consumer or
# realtime-delivery-consumer. Both roles relay realtime payloads to gateway over
# authenticated internal HTTP in production; keep the same secret as gateway.
# IM_GATEWAY_RELAY_MODE=http
# IM_GATEWAY_INTERNAL_BASE_URL=http://gateway.internal:8080
# IM_INTERNAL_SHARED_SECRET=replace-me
# Required for domain-delivery-consumer in production: skip durable per-owner
# message_created event copies at or above this recipient count. Clients catch
# up through conversation timeline/since, while small groups and non-message
# events keep owner delivery. Requires exactly one realtime path: either a
# dedicated realtime-delivery-consumer, or IM_DOMAIN_DELIVERY_RELAY_AFTER_RECORD=true
# on a domain-delivery-only deployment. Do not enable relay-after-record when
# realtime-delivery-consumer is also enabled.
IM_DOMAIN_DELIVERY_MESSAGE_CREATED_LARGE_GROUP_MODE=timeline-pull
IM_DOMAIN_DELIVERY_MESSAGE_CREATED_OWNER_DELIVERY_SKIP_RECIPIENT_THRESHOLD=500
# Caps each Postgres owner-delivery INSERT/sequence allocation statement. Keep
# this large enough to avoid per-owner single-row SQL and below database
# parameter/body limits; increase only after measuring owner-delivery batch
# write latency and errors. Production validation accepts 100...5000.
IM_DOMAIN_DELIVERY_OWNER_RECORD_BATCH_MAX_REQUESTS=1000

# Required for notification-consumer in production: skip owner-scoped
# message_created notification rows at or above this recipient count. Large
# groups rely on summary changes, realtime lightweight hints, and timeline
# catch-up instead of writing one notification record per member per message.
# Must be <= IM_DOMAIN_DELIVERY_MESSAGE_CREATED_OWNER_DELIVERY_SKIP_RECIPIENT_THRESHOLD
# when notification-consumer and domain-delivery-consumer are both enabled in
# the same deployment window, unless IM_NOTIFICATION_SKIP_MESSAGE_CREATED_OWNER_NOTIFICATIONS=true.
IM_NOTIFICATION_MESSAGE_CREATED_OWNER_NOTIFICATION_SKIP_RECIPIENT_THRESHOLD=500

# Required for realtime-delivery-consumer in production: keep small groups
# full-fidelity, but omit per-recipient conversation summaries from large-group
# message_created realtime payloads. Gateway active fanout keeps full messages
# for active chat viewers and coalesces inactive conversation hints at the edge.
# Must be <= IM_DOMAIN_DELIVERY_MESSAGE_CREATED_OWNER_DELIVERY_SKIP_RECIPIENT_THRESHOLD
# when owner-delivery skip is enabled by threshold, so every skipped large-group
# message also uses lightweight realtime payloads.
IM_REALTIME_MESSAGE_CREATED_LIGHTWEIGHT_RECIPIENT_THRESHOLD=500
IM_REALTIME_MESSAGE_CREATED_LIGHTWEIGHT_PREVIEW_MAX_CHARS=120
# Active compact hints are for users already viewing the hot conversation. Keep
# previews bounded while timeline/since remains the durable catch-up source.
IM_REALTIME_ACTIVE_COMPACT_HINT_PREVIEW_MAX_CHARS=120
# Production hot large-group realtime must rely on message_created embedded
# previews. Keep disabled so missing previews surface through
# im_domain_event_message_created_preview_missing_total instead of causing one
# message-table read per hot message.
IM_REALTIME_MESSAGE_CREATED_PREVIEW_LOOKUP_ENABLED=false
# Required in production: route/split failures drop best-effort realtime fanout
# and clients recover through timeline/since.
# Required in production: reuse active-room route lookups across a short hot
# conversation window. Keep this close to the inactive hint coalescing window so
# large groups avoid one Redis active-route lookup per message without retaining
# stale active-viewer state for long.
IM_REALTIME_ACTIVE_CONVERSATION_ROUTE_CACHE_TTL_MS=1000
# Bound the stream-consumer route cache because each entry stores one hot
# conversation+user route result, including inactive negative results. Raise only
# after measuring stream-consumer memory.
IM_REALTIME_ACTIVE_CONVERSATION_ROUTE_CACHE_MAX_ENTRIES=4096
# Required for realtime-delivery-consumer and domain-delivery relay-after-record
# in production. This coalesces hot large-group inactive-list hints by
# conversation when inactive hint fanout is explicitly enabled.
# In the default pull-only posture, active chat viewers use the separate active
# compact setting below and inactive users catch up from changes/timeline.
IM_REALTIME_MESSAGE_CREATED_COALESCE_WINDOW_MS=1000
# Active chat viewers should not inherit the inactive-list debounce window. Use
# a short merge window so hot rooms collapse repeated compact hints by recipient
# while keeping visible-message catch-up latency below one frame.
IM_REALTIME_ACTIVE_COMPACT_HINT_COALESCE_WINDOW_MS=25
IM_REALTIME_DELIVERY_ASYNC_RELAY_ENABLED=true
IM_REALTIME_DELIVERY_ASYNC_MAX_IN_FLIGHT=32
IM_REALTIME_DELIVERY_ASYNC_MAX_QUEUED=1024
IM_REALTIME_REMOTE_DISPATCH_USER_BATCH_SIZE=512
IM_REALTIME_REMOTE_DISPATCH_MAX_IN_FLIGHT=8
# Required when owner-delivery skip is enabled: must be <=
# IM_DOMAIN_DELIVERY_MESSAGE_CREATED_OWNER_DELIVERY_SKIP_RECIPIENT_THRESHOLD so
# every skip-owner-delivery group is protected by active/inactive fanout.
IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_ENABLED=true
IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_RECIPIENT_THRESHOLD=500
# Must be > 0, <= IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_RECIPIENT_THRESHOLD,
# and <= the production hard cap of 128 so active full-message fanout remains bounded.
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_LIMIT=128
# Production hot groups use compact realtime hints for active viewers too.
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_MODE=compact-only
# Per-message budget for full payload fanout from one hot conversation. If a
# message payload is large, fewer active viewers receive full realtime delivery
# and overflow viewers receive lightweight hints plus timeline catch-up.
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_PAYLOAD_BYTE_BUDGET=262144
# Production large groups do not realtime-fanout conversation-list hints to
# inactive online users. Inactive clients advance via conversation changes and
# timeline/since catch-up, while active chat viewers still receive compact hints.
IM_REALTIME_INACTIVE_CONVERSATION_HINT_MODE=pull-only
IM_REALTIME_INACTIVE_CONVERSATION_HINT_DEBOUNCE_SECONDS=1
# Optional finer-grained override for the debounce above, for example 200.
# IM_REALTIME_INACTIVE_CONVERSATION_HINT_DEBOUNCE_MS=200
IM_REALTIME_INACTIVE_CONVERSATION_HINT_MAX_PENDING_RECIPIENTS=5000

# Use database search indexing until OpenSearch is explicitly provisioned.
IM_SEARCH_DRIVER=database
# IM_SEARCH_DRIVER=opensearch
# IM_OPENSEARCH_ENDPOINT=https://opensearch.internal
IM_OPENSEARCH_INDEX=conversation-message-search
