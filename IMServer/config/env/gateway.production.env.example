APP_ENV=production
IM_NODE_ID=gateway-1
JWT_SECRET=replace-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
IM_TCP_LISTEN_BACKLOG=1024
IM_TCP_REQUIRES_TLS_TERMINATION=true
IM_TCP_WRITE_BUFFER_LOW_WATERMARK=524288
IM_TCP_WRITE_BUFFER_HIGH_WATERMARK=1048576
IM_TCP_SLOW_WRITE_THRESHOLD_MS=1000
IM_TCP_SLOW_WRITE_CLOSE_CONSECUTIVE_COUNT=3
IM_TCP_DROP_REALTIME_WHEN_NOT_WRITABLE=true

REDIS_URL=redis://user:pass@redis-cluster.example:6379
IM_REDIS_MAX_CONNECTIONS=32
IM_REDIS_PRESENCE_HEARTBEAT_TIMEOUT_SECONDS=90
IM_REDIS_ACTIVE_CONVERSATION_ROUTE_TTL_SECONDS=900
# Short in-process cache for active conversation user-set snapshots and
# user->node active route lookups. Keep low so conversation presence changes
# propagate quickly while hot groups avoid repeated Redis active_users scans.
IM_REDIS_ACTIVE_CONVERSATION_ROUTE_CACHE_TTL_SECONDS=2
IM_METRICS_ENABLED=true

DATABASE_PRIMARY_HOST=pg-primary.example
DATABASE_PRIMARY_PORT=5432
DATABASE_PRIMARY_USERNAME=im_app
DATABASE_PRIMARY_PASSWORD=replace-me
DATABASE_PRIMARY_NAME=im_primary
DATABASE_GATEWAY_MAX_CONNECTIONS_PER_EVENT_LOOP=4
DATABASE_GATEWAY_CONNECTION_POOL_TIMEOUT_SECONDS=30

DATABASE_REPLICA_HOST=pg-replica.example
DATABASE_REPLICA_PORT=5432
DATABASE_REPLICA_USERNAME=im_app
DATABASE_REPLICA_PASSWORD=replace-me
DATABASE_REPLICA_NAME=im_primary

IM_GATEWAY_RELAY_MODE=local
IM_GATEWAY_LOCAL_FANOUT_BATCH_SIZE=64
IM_GATEWAY_LOCAL_FANOUT_EVENT_LOOP_YIELD_CHUNKS=64
IM_GATEWAY_RELAY_DOMAIN_EVENT_PACKET_MAX_BODY_BYTES=1048576
IM_GATEWAY_RELAY_DOMAIN_EVENT_PACKET_BIN_MAX_BODY_BYTES=1048576
IM_GATEWAY_RELAY_DOMAIN_EVENT_PACKETS_MAX_BODY_BYTES=262144
IM_REALTIME_REMOTE_DISPATCH_USER_BATCH_SIZE=512
# Must be > 1 in production so cross-node large-group realtime fanout is concurrent.
IM_REALTIME_REMOTE_DISPATCH_MAX_IN_FLIGHT=8
IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_ENABLED=true
IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_RECIPIENT_THRESHOLD=500
# Must be > 0, <= IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_RECIPIENT_THRESHOLD,
# and <= the production hard cap of 128 so a hot room cannot force unbounded
# full-message fanout.
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_LIMIT=128
# Production hot groups use compact realtime hints for active viewers too.
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_MODE=compact-only
# Production gateway-generated active compact hints carry a bounded message
# preview for users already viewing the hot conversation. The client still
# reconciles through timeline/since.
IM_REALTIME_ACTIVE_COMPACT_HINT_PREVIEW_MAX_CHARS=120
# Per-message budget for full payload fanout from one hot conversation. Larger
# payloads automatically shrink full-message fanout and overflow users receive
# lightweight hints plus timeline catch-up.
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_PAYLOAD_BYTE_BUDGET=262144
# Production large groups do not realtime-fanout conversation-list hints to
# inactive online users. Inactive clients advance via conversation changes and
# timeline/since catch-up, while active chat viewers still receive compact hints.
IM_REALTIME_INACTIVE_CONVERSATION_HINT_MODE=pull-only
IM_REALTIME_INACTIVE_CONVERSATION_HINT_DEBOUNCE_SECONDS=1
# Optional finer-grained override for the debounce above, for example 200.
# IM_REALTIME_INACTIVE_CONVERSATION_HINT_DEBOUNCE_MS=200
IM_REALTIME_INACTIVE_CONVERSATION_HINT_MAX_PENDING_RECIPIENTS=5000
IM_COMMAND_API_INTERNAL_BASE_URL=http://command-api-internal.example:8080
IM_INTERNAL_SHARED_SECRET=replace-me
