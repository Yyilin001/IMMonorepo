# Copy to production-acceptance.env and fill with real production values.
# Never commit the filled file. Root .gitignore excludes non-example *.env files.

# Public production target. Export the PRODUCTION_ACCEPTANCE_* values from your
# operator shell or replace these assignments with real production values before
# sourcing this file.
# BASE_URL must be the HTTPS origin on the default 443 port. Do not append /api,
# query strings, fragments, or userinfo. TCP_HOST must be only the DNS hostname
# for the public TCP gateway; do not include :9000.
BASE_URL=${PRODUCTION_ACCEPTANCE_BASE_URL:?set-PRODUCTION_ACCEPTANCE_BASE_URL}
TCP_HOST=${PRODUCTION_ACCEPTANCE_TCP_HOST:?set-PRODUCTION_ACCEPTANCE_TCP_HOST}
TCP_PORT=${PRODUCTION_ACCEPTANCE_TCP_PORT:-9000}

# Full final acceptance requires at least 10000 usable email,password rows.
# The file must contain accounts provisioned for the target production system.
ACCOUNT_FILE=${PRODUCTION_ACCEPTANCE_ACCOUNT_FILE:?set-PRODUCTION_ACCEPTANCE_ACCOUNT_FILE}

# Use a real non-nil conversation UUID created for this acceptance run.
IM_CONVERSATION_ID=${PRODUCTION_ACCEPTANCE_CONVERSATION_ID:?set-PRODUCTION_ACCEPTANCE_CONVERSATION_ID}

# Load this from the operator secret store or shell environment before sourcing
# the file. Do not write the real secret here.
IM_INTERNAL_SECRET=${IM_INTERNAL_SECRET:?set-IM_INTERNAL_SECRET}

# Final acceptance must use the full wrapper. Baseline is only for an explicit
# pre-final check and is not enough for a production-ready claim.
PRODUCTION_ACCEPTANCE_LEVEL=full
PRODUCTION_ACCEPTANCE_RESULT_ROOT=IMServer/LoadTests/results/production-acceptance
PRODUCTION_ACCEPTANCE_PACKAGE_EVIDENCE=true
PRODUCTION_ACCEPTANCE_VERIFY_RECEIPT=true
PRODUCTION_ACCEPTANCE_RECEIPT_MAX_AGE_SECONDS=86400
PRODUCTION_ACCEPTANCE_RECEIPT_MAX_FUTURE_SKEW_SECONDS=300

# Cloud security-group evidence. The snapshot must be fresh, audited, and owned
# by root on the production host. The repair receipt must be fresh and verified.
CLOUD_SECURITY_GROUP_RULES_FILE=/etc/imserver/cloud-security-group.json
PRODUCTION_ACCEPTANCE_CLOUD_SECURITY_GROUP_REPAIR_RECEIPT_JSON=/var/lib/imserver/cloud-security-group/repairs/latest-repair-receipt.json
PRODUCTION_ACCEPTANCE_CLOUD_SECURITY_GROUP_REPAIR_RECEIPT_MAX_AGE_SECONDS=86400
PRODUCTION_ACCEPTANCE_CLOUD_SECURITY_GROUP_REPAIR_RECEIPT_EXPECT_SECURITY_GROUP_ID=sg-REPLACE_ME
PRODUCTION_ACCEPTANCE_CLOUD_SECURITY_GROUP_REPAIR_RECEIPT_EXPECT_REGION_ID=cn-shenzhen
PRODUCTION_ACCEPTANCE_CLOUD_SECURITY_GROUP_REPAIR_RECEIPT_EXPECT_ADMIN_CIDR=203.0.113.10/32

# After run_production_acceptance.sh completes, fill these with the generated
# receipt and evidence tarball. Also point the topology smoke receipt at the
# latest passing production-smoke run, and the deploy readiness receipt at the
# latest successful production readiness gate before final verification.
# PRODUCTION_TOPOLOGY_SMOKE_RECEIPT_JSON=IMServer/reports/latest-production-smoke.json
# PRODUCTION_TOPOLOGY_SMOKE_MAX_AGE_SECONDS=86400
# PRODUCTION_DEPLOY_READINESS_RECEIPT_JSON=/var/lib/imserver/readiness/latest.json
# PRODUCTION_DEPLOY_READINESS_MAX_AGE_SECONDS=86400
# PRODUCTION_ACCEPTANCE_RECEIPT_JSON=IMServer/LoadTests/results/production-acceptance/<run-id>/production-acceptance.json
# PRODUCTION_EVIDENCE_PACKAGE=IMServer/LoadTests/results/production-acceptance/production-evidence/production-evidence-<run-id>.tar.gz
