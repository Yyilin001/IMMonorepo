# Local PostgreSQL config for Vapor development.
# Copy to `.env.local` and adjust values if your local role/database differ.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vapor_auth
DATABASE_USERNAME=your_pg_role
DATABASE_PASSWORD=
JWT_SECRET=dev-jwt-secret-change-me
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=password1234
