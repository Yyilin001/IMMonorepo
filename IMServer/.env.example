# Local PostgreSQL config for Vapor development only.
#
# Do not use this file as a production baseline. Several values below preserve
# single-process local compatibility and intentionally disable production
# large-group protections. Production role templates live under
# `config/env/*.production.env.example`; validate real deployment env files with
# `scripts/production_env_preflight.sh --strict-secrets`.
#
# Copy this file to `.env.local` and adjust values for local development.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vapor_auth
DATABASE_USERNAME=your_pg_role
DATABASE_PASSWORD=
DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=1
DATABASE_CONNECTION_POOL_TIMEOUT_SECONDS=10
# Role-specific overrides use the runtime role name, uppercased with punctuation replaced by underscores.
# DATABASE_GATEWAY_MAX_CONNECTIONS_PER_EVENT_LOOP=4
# DATABASE_GATEWAY_CONNECTION_POOL_TIMEOUT_SECONDS=30
JWT_SECRET=dev-jwt-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
IM_TCP_LISTEN_BACKLOG=1024
IM_TCP_WRITE_BUFFER_LOW_WATERMARK=524288
IM_TCP_WRITE_BUFFER_HIGH_WATERMARK=1048576
IM_TCP_SLOW_WRITE_THRESHOLD_MS=1000
IM_TCP_SLOW_WRITE_CLOSE_CONSECUTIVE_COUNT=3
IM_TCP_DROP_REALTIME_WHEN_NOT_WRITABLE=true
IM_REDIS_PRESENCE_HEARTBEAT_TIMEOUT_SECONDS=90
IM_REDIS_ACTIVE_CONVERSATION_ROUTE_TTL_SECONDS=900
IM_REDIS_ACTIVE_CONVERSATION_ROUTE_CACHE_TTL_SECONDS=2
SEED_USER_EMAIL=demo@example.com
SEED_USER_EMAILS=demo@example.com,alice@example.com,bob@example.com,carol@example.com,dave@example.com
SEED_USER_PASSWORD=password1234
IM_SEQUENCE_ALLOCATION_MODE=legacy
IM_SEQUENCE_BLOCK_SIZE=256
IM_GROUP_MEMBER_LIMIT=1000
IM_CONVERSATION_MEMBER_CACHE_TTL_SECONDS=300
IM_MESSAGE_WRITE_BATCH_ENABLED=false
IM_MESSAGE_WRITE_BATCH_MAX_SIZE=32
IM_MESSAGE_WRITE_BATCH_MAX_DELAY_MS=10
IM_OUTBOX_BATCH_SIZE=200
IM_OUTBOX_POLL_INTERVAL_MS=50
IM_OUTBOX_IDLE_POLL_MIN_INTERVAL_MS=50
IM_OUTBOX_ACTIVE_IDLE_WINDOW_MS=5000
IM_OUTBOX_NOTIFY_ENABLED=false
IM_OUTBOX_NOTIFY_CHANNEL=im_conversation_outbox
IM_KAFKA_POLL_INTERVAL_MS=20
IM_STREAM_CONSUMER_QUEUE_CAPACITY=512
IM_STREAM_CONSUMER_RUN_BATCH_SIZE=32
IM_STREAM_CONSUMER_BATCH_FILL_WAIT_MS=0
IM_DOMAIN_DELIVERY_FANOUT_CONCURRENCY=4
IM_DOMAIN_DELIVERY_RELAY_BATCH_SIZE=16
IM_DOMAIN_DELIVERY_OWNER_RECORD_BATCH_MAX_REQUESTS=1000
IM_DOMAIN_DELIVERY_REPLAY_RECORDS_ENABLED=false
IM_DOMAIN_DELIVERY_RELAY_AFTER_RECORD=false
# Local compatibility path. Production large groups must use
# IM_DOMAIN_DELIVERY_MESSAGE_CREATED_LARGE_GROUP_MODE=timeline-pull with a
# non-zero skip threshold in the stream-consumer role env.
IM_DOMAIN_DELIVERY_SKIP_MESSAGE_CREATED_OWNER_DELIVERY=false
IM_DOMAIN_DELIVERY_MESSAGE_CREATED_LARGE_GROUP_MODE=owner-delivery
IM_DOMAIN_DELIVERY_MESSAGE_CREATED_OWNER_DELIVERY_SKIP_RECIPIENT_THRESHOLD=0
IM_NOTIFICATION_SKIP_MESSAGE_CREATED_OWNER_NOTIFICATIONS=false
IM_NOTIFICATION_MESSAGE_CREATED_OWNER_NOTIFICATION_SKIP_RECIPIENT_THRESHOLD=0
# Local compatibility path. Production realtime-delivery-consumer envs must
# enable async relay, lightweight message_created payloads, preview lookup
# bypass, and coalescing as shown in config/env/stream-consumer.production.env.example.
IM_REALTIME_DELIVERY_ASYNC_RELAY_ENABLED=false
IM_REALTIME_DELIVERY_ASYNC_MAX_IN_FLIGHT=32
IM_REALTIME_DELIVERY_ASYNC_MAX_QUEUED=1024
IM_REALTIME_DELIVERY_SLOW_LOG_MS=1000
IM_REALTIME_REMOTE_DISPATCH_USER_BATCH_SIZE=512
IM_REALTIME_REMOTE_DISPATCH_MAX_IN_FLIGHT=8
IM_REALTIME_MESSAGE_CREATED_LIGHTWEIGHT_RECIPIENT_THRESHOLD=0
IM_REALTIME_MESSAGE_CREATED_LIGHTWEIGHT_PREVIEW_MAX_CHARS=120
IM_REALTIME_MESSAGE_CREATED_PREVIEW_LOOKUP_ENABLED=true
IM_REALTIME_ACTIVE_CONVERSATION_UNSPLIT_FALLBACK_ENABLED=false
IM_REALTIME_MESSAGE_CREATED_COALESCE_WINDOW_MS=0
# Local compatibility path. Production summary-projection-consumer and command-api
# envs must set non-zero thresholds so hot large groups do not write per-owner
# summary/change-log rows or inline every recipient in each outbox event.
IM_SUMMARY_PROJECTION_MESSAGE_CREATED_ACTIVITY_ONLY_RECIPIENT_THRESHOLD=0
IM_STREAM_CONSUMER_REQUIRE_MESSAGE_CREATED_RECIPIENT_SNAPSHOT=false
IM_MESSAGE_CREATED_RECIPIENT_INLINE_THRESHOLD=0
IM_DOMAIN_EVENT_RECIPIENT_SNAPSHOT_DEDUP_THRESHOLD=0
IM_TIMELINE_READ_VISIBILITY_SCAN_MAX_ROWS=5000
IM_TIMELINE_READ_VISIBILITY_SCAN_MAX_PAGES=50
IM_TIMELINE_SINCE_HOT_CACHE_TTL_MS=250
IM_TIMELINE_SINCE_HOT_CACHE_MAX_ENTRIES=4096
IM_TIMELINE_SINCE_RECENT_CACHE_TTL_MS=2000
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_CONVERSATIONS=1024
IM_TIMELINE_SINCE_RECENT_CACHE_MAX_ITEMS_PER_CONVERSATION=512
IM_TIMELINE_SINCE_TARGET_SEQUENCE_COALESCE_WINDOW_MS=5
IM_CLEANUP_ENABLED=false
IM_CLEANUP_INTERVAL_SECONDS=86400
IM_CLEANUP_RECIPIENT_SET_RETENTION_DAYS=30
IM_CLEANUP_RECIPIENT_SET_BATCH_SIZE=1000
# Local compatibility path. Production gateways must enable active/inactive
# fanout, compact-only active fanout, and a bounded full-fanout payload budget.
IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_ENABLED=false
IM_REALTIME_ACTIVE_CONVERSATION_FANOUT_RECIPIENT_THRESHOLD=500
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_LIMIT=0
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_MODE=bounded
IM_REALTIME_ACTIVE_COMPACT_HINT_BODY=timeline-gap
IM_REALTIME_ACTIVE_COMPACT_HINT_PREVIEW_MAX_CHARS=0
IM_REALTIME_ACTIVE_CONVERSATION_FULL_FANOUT_PAYLOAD_BYTE_BUDGET=0
IM_REALTIME_INACTIVE_CONVERSATION_HINT_DEBOUNCE_SECONDS=1
# Optional finer-grained override for the debounce above, for example 200.
# IM_REALTIME_INACTIVE_CONVERSATION_HINT_DEBOUNCE_MS=200
IM_REALTIME_INACTIVE_CONVERSATION_HINT_MAX_PENDING_RECIPIENTS=5000
IM_GATEWAY_LOCAL_FANOUT_BATCH_SIZE=64
IM_GATEWAY_LOCAL_FANOUT_EVENT_LOOP_YIELD_CHUNKS=64
IM_GATEWAY_RELAY_DOMAIN_EVENT_PACKET_MAX_BODY_BYTES=1048576
IM_GATEWAY_RELAY_DOMAIN_EVENT_PACKET_BIN_MAX_BODY_BYTES=1048576
IM_GATEWAY_RELAY_DOMAIN_EVENT_PACKETS_MAX_BODY_BYTES=262144
IM_DOMAIN_DELIVERY_TRANSIENT_MAX_ATTEMPTS=3
IM_DOMAIN_DELIVERY_TIMELINE_NOTICE_MAX_WAIT_MS=10000
IM_DOMAIN_DELIVERY_TIMELINE_NOTICE_RETRY_DELAY_MS=100
