# Local PostgreSQL config for Vapor development only.
# Production role templates live under `config/env/*.production.env.example`.
# Copy this file to `.env.local` and adjust values for local development.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vapor_auth
DATABASE_USERNAME=your_pg_role
DATABASE_PASSWORD=
DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=1
DATABASE_CONNECTION_POOL_TIMEOUT_SECONDS=10
# Role-specific overrides use the runtime role name, uppercased with punctuation replaced by underscores.
# DATABASE_GATEWAY_MAX_CONNECTIONS_PER_EVENT_LOOP=4
# DATABASE_GATEWAY_CONNECTION_POOL_TIMEOUT_SECONDS=30
JWT_SECRET=dev-jwt-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
IM_TCP_LISTEN_BACKLOG=1024
SEED_USER_EMAIL=demo@example.com
SEED_USER_EMAILS=demo@example.com,alice@example.com,bob@example.com,carol@example.com,dave@example.com
SEED_USER_PASSWORD=password1234
IM_SEQUENCE_ALLOCATION_MODE=legacy
IM_SEQUENCE_BLOCK_SIZE=256
IM_CONVERSATION_MEMBER_CACHE_TTL_SECONDS=10
IM_MESSAGE_WRITE_BATCH_ENABLED=false
IM_MESSAGE_WRITE_BATCH_MAX_SIZE=32
IM_MESSAGE_WRITE_BATCH_MAX_DELAY_MS=10
IM_OUTBOX_BATCH_SIZE=200
IM_OUTBOX_POLL_INTERVAL_MS=50
IM_OUTBOX_IDLE_POLL_MIN_INTERVAL_MS=50
IM_OUTBOX_ACTIVE_IDLE_WINDOW_MS=5000
IM_OUTBOX_NOTIFY_ENABLED=false
IM_OUTBOX_NOTIFY_CHANNEL=im_conversation_outbox
IM_KAFKA_POLL_INTERVAL_MS=20
IM_DOMAIN_DELIVERY_FANOUT_CONCURRENCY=4
IM_DOMAIN_DELIVERY_RELAY_BATCH_SIZE=16
IM_DOMAIN_DELIVERY_REPLAY_RECORDS_ENABLED=false
IM_DOMAIN_DELIVERY_RELAY_AFTER_RECORD=false
IM_DOMAIN_DELIVERY_SKIP_MESSAGE_CREATED_OWNER_DELIVERY=false
IM_REALTIME_DELIVERY_ASYNC_RELAY_ENABLED=false
IM_REALTIME_DELIVERY_ASYNC_MAX_IN_FLIGHT=32
IM_REALTIME_DELIVERY_SLOW_LOG_MS=1000
IM_REALTIME_MESSAGE_CREATED_LIGHTWEIGHT_RECIPIENT_THRESHOLD=0
IM_REALTIME_MESSAGE_CREATED_LIGHTWEIGHT_PREVIEW_MAX_CHARS=120
IM_REALTIME_MESSAGE_CREATED_COALESCE_WINDOW_MS=0
IM_DOMAIN_DELIVERY_TRANSIENT_MAX_ATTEMPTS=3
IM_DOMAIN_DELIVERY_TIMELINE_NOTICE_MAX_WAIT_MS=10000
IM_DOMAIN_DELIVERY_TIMELINE_NOTICE_RETRY_DELAY_MS=100
