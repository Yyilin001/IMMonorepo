# Keep only the static Go `promtool` binary from the same pinned image used by
# the host fallback checker; installing Ubuntu's full Prometheus package pulls
# its web assets and service dependencies into every disposable Swift runner.
FROM prom/prometheus:v2.54.1 AS promtool

# The test runner is intentionally Linux-only and disposable. Source is
# mounted read-only by compose; SwiftPM artifacts are written under /tmp.
FROM swift:6.4-jammy@sha256:a6053d2de72091906bfa064f76f145e3f28830664cae250e1b84aa8c499a8ee6

COPY --from=promtool /bin/promtool /usr/local/bin/promtool

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        coreutils \
        ffmpeg \
        libsqlite3-dev \
        protobuf-compiler \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

ENTRYPOINT ["bash", "IMV2/scripts/run_v2_isolated_tests.sh"]
