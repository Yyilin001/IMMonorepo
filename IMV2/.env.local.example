# This file is a template only. `run_v2_local_account_stack.sh` creates
# IMV2/.env.local with fresh local-only values when it does not exist.
# Enable only after the account resource endpoint and matching backend/signing
# configuration are ready. This is independent of the storage/CDN provider.
IM_V2_AUTHOR_PRESENTATIONS_ENABLED=false
# Message operations use the authenticated TCP connection.
# Independent bounded online membership coverage, not derived from socket count.
# These are process limits; exceeding them fails coverage establishment.
IM_V2_ONLINE_DELIVERY_MAX_ROOMS=65536
IM_V2_ONLINE_DELIVERY_MAX_RELATIONS=262144
IM_V2_MESSAGE_SEND_OPERATIONS_ENABLED=true
# Per-connection and process limits for outstanding message requests.
IM_V2_MESSAGE_SEND_MAX_IN_FLIGHT_PER_CONNECTION=4
IM_V2_MESSAGE_SEND_MAX_IN_FLIGHT_BYTES_PER_CONNECTION=4194304
IM_V2_MESSAGE_SEND_MAX_IN_FLIGHT_BYTES_PROCESS=67108864
IM_V2_LOCAL_POSTGRES_PASSWORD=replace-with-a-local-password
IM_V2_ACCESS_TOKEN_HMAC_KEY_BASE64=replace-with-random-32-byte-or-longer-base64
IM_V2_CREDENTIAL_REPLAY_ENVELOPE_KEY_BASE64=replace-with-random-32-byte-base64
IM_V2_PUSH_ENDPOINT_ENVELOPE_KEY_BASE64=replace-with-random-32-byte-base64
IM_V2_ACCOUNT_EDGE_AUTHORIZATION_SECRET_BASE64=replace-with-random-32-byte-base64
IM_V2_ACCOUNT_CLIENT_RATE_LIMIT_HMAC_KEY_BASE64=replace-with-random-32-byte-base64
IM_V2_ACCOUNT_ASSERTION_HMAC_KEY_BASE64=replace-with-random-32-byte-or-longer-base64
IM_V2_GROUP_INVITE_TOKEN_HMAC_KEY_BASE64=replace-with-random-32-byte-or-longer-base64
IM_V2_LOCAL_MEDIA_SIGNING_KEY_BASE64=replace-with-random-32-byte-or-longer-base64
IM_V2_OPERATOR_REPLAY_BEARER_TOKEN_BASE64=replace-with-random-32-byte-base64
IM_V2_OPERATOR_ACCOUNT_DISABLE_BEARER_TOKEN_BASE64=replace-with-random-32-byte-base64
