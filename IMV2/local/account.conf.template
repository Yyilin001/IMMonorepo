ssl_certificate /run/im-edge-tls/leaf.pem;
ssl_certificate_key /run/im-edge-tls/leaf.key;
ssl_protocols TLSv1.2 TLSv1.3;
http2 on;
server_tokens off;
server {
    listen 8443 ssl default_server;
    server_name _;
    return 421;
}
server {
    listen 8443 ssl;
    server_name localhost account;
    # Account validates upload and response limits for each route.
    client_max_body_size 0;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:8444;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-IM-V2-Account-Edge-Authorization "${IM_V2_ACCOUNT_EDGE_AUTHORIZATION_SECRET_BASE64}";
        proxy_set_header X-IM-V2-Account-Client-Address $remote_addr;
    }
}
