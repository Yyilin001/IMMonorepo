# Local-only account service image. Source is compiled in a disposable build
# stage; the final image contains only the four release executables and their
# bundled SwiftPM runtime artifacts. Keeping `.build` and source out of the
# runtime stage prevents repeated local verification from retaining several
# gigabytes of compiler products per image.
FROM swift:6.4-jammy@sha256:a6053d2de72091906bfa064f76f145e3f28830664cae250e1b84aa8c499a8ee6 AS build

# The classic Docker builder keeps completed multi-stage build images as
# dangling layers. This label lets the local-stack script reclaim only these
# unreferenced, source-compilation layers without touching user images/volumes.
LABEL com.imv2.local-account-build-stage=true

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY IMV2Core ./IMV2Core
COPY IMV2Compression ./IMV2Compression
COPY IMV2Server ./IMV2Server

# The local stack runs the account issuer, V2 TLS gateway, and the separately
# loopback-only operator control plane from one immutable source image, but as
# independent processes with separate listeners. Build all executable products
# now. Running `swift run` in a container would
# otherwise compile the selected executable after the listener port is already
# published, producing a misleading short-lived 502/connection-refused state.
# Only `/runtime` is consumed by the final stage, so delete checkout/object
# caches before the legacy builder snapshots this layer. This prevents a build
# from needing several extra gigabytes merely to commit disposable products.
# Compile one frontend at a time to keep the local release build within a
# bounded-memory Docker VM.
RUN set -eu; \
    swift build --disable-automatic-resolution -c release --jobs 1 --package-path IMV2Server --product IMV2AccountServerApp \
    && swift build --disable-automatic-resolution -c release --jobs 1 --package-path IMV2Server --product IMV2ServerApp \
    && swift build --disable-automatic-resolution -c release --jobs 1 --package-path IMV2Server --product IMV2OperatorServerApp \
    && swift build --disable-automatic-resolution -c release --jobs 1 --package-path IMV2Server --product IMV2LocalGatewayProbe \
    && swift build --disable-automatic-resolution -c release --jobs 1 --package-path IMV2Server --product IMV2ResourceImageWorker \
    && bin_path="$(swift build --disable-automatic-resolution -c release --package-path IMV2Server --show-bin-path)" \
    && mkdir -p /runtime/IMV2Server/.build/release \
    && cp "${bin_path}/IMV2AccountServerApp" \
          "${bin_path}/IMV2ServerApp" \
          "${bin_path}/IMV2OperatorServerApp" \
          "${bin_path}/IMV2LocalGatewayProbe" \
          "${bin_path}/IMV2ResourceImageWorker" \
          /runtime/IMV2Server/.build/release/ \
    && rm -rf /workspace/IMV2Server/.build /root/.cache/org.swift.swiftpm

FROM swift:6.4-jammy@sha256:a6053d2de72091906bfa064f76f145e3f28830664cae250e1b84aa8c499a8ee6

RUN sed -i 's|http://ports.ubuntu.com/ubuntu-ports/|https://ports.ubuntu.com/ubuntu-ports/|g' /etc/apt/sources.list \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl imagemagick \
    && rm -rf /var/lib/apt/lists/*

COPY IMV2Server/Resources/imagemagick-policy.xml /etc/ImageMagick-6/policy.xml

WORKDIR /workspace
# The package products statically contain their SwiftPM dependencies; the
# runtime image already supplies the Swift/Foundation shared libraries. Keep
# the existing Compose command paths, but copy only the four executable
# products instead of SwiftPM's multi-gigabyte object/module/compiler cache.
COPY --from=build /runtime/IMV2Server/.build/release ./IMV2Server/.build/release

CMD ["/workspace/IMV2Server/.build/release/IMV2AccountServerApp"]
