{
  "title": "IMServer Capacity",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP RPS",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(im_http_requests_total[1m]))", "legendFormat": "requests/s"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP Failure RPS",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(im_http_request_failures_total[1m]))", "legendFormat": "failures/s"}]
    },
    {
      "type": "timeseries",
      "title": "TCP Connections",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum(im_tcp_connections)", "legendFormat": "connections"}]
    },
    {
      "type": "timeseries",
      "title": "Outbox Backlog",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum(im_outbox_backlog_events)", "legendFormat": "events"}]
    },
    {
      "type": "timeseries",
      "title": "Projection and Search Lag",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "max(im_projection_lag_millis)", "legendFormat": "projection"},
        {"expr": "max(im_search_lag_millis)", "legendFormat": "search"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Stream Events",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "sum(rate(im_stream_consumed_events_total[1m]))", "legendFormat": "consumed/s"},
        {"expr": "sum(rate(im_stream_failed_events_total[1m]))", "legendFormat": "failed/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Realtime Routing",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {"expr": "sum(rate(im_user_fanout_total[1m]))", "legendFormat": "user fanout/s"},
        {"expr": "sum(rate(im_session_kick_total[1m]))", "legendFormat": "session kick/s"},
        {"expr": "sum(rate(im_cross_node_dispatch_total[1m]))", "legendFormat": "cross-node dispatch/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Realtime Routing Failures",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {"expr": "sum(rate(im_cross_node_dispatch_failures_total[1m]))", "legendFormat": "cross-node failures/s"},
        {"expr": "sum(rate(im_session_count_query_failures_total[1m]))", "legendFormat": "session-count failures/s"},
        {"expr": "sum(rate(im_redis_presence_stale_cleanup_total[1m]))", "legendFormat": "stale cleanup/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "AI Stream Lifecycle",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {"expr": "sum(im_ai_stream_active)", "legendFormat": "active"},
        {"expr": "sum(rate(im_ai_stream_started_total[1m]))", "legendFormat": "started/s"},
        {"expr": "sum(rate(im_ai_stream_completed_total[1m]))", "legendFormat": "completed/s"},
        {"expr": "sum(rate(im_ai_stream_failed_total[1m]))", "legendFormat": "failed/s"},
        {"expr": "sum(rate(im_ai_stream_cancelled_total[1m]))", "legendFormat": "cancelled/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "AI Stream Chunks and Snapshots",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [
        {"expr": "sum(rate(im_ai_stream_chunks_published_total[1m]))", "legendFormat": "chunks/s"},
        {"expr": "sum(rate(im_ai_stream_snapshot_writes_total[1m]))", "legendFormat": "snapshot writes/s"},
        {"expr": "sum(rate(im_ai_stream_chunk_db_bypasses_total[1m]))", "legendFormat": "chunk db bypass/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "AI Stream Lease",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "targets": [
        {"expr": "sum(rate(im_ai_stream_lease_reservations_total[1m]))", "legendFormat": "reservations/s"},
        {"expr": "sum(rate(im_ai_stream_lease_rejections_total[1m]))", "legendFormat": "rejections/s"},
        {"expr": "sum(rate(im_ai_stream_lease_heartbeats_total[1m]))", "legendFormat": "heartbeats/s"},
        {"expr": "sum(rate(im_ai_stream_lease_cancellations_total[1m]))", "legendFormat": "cancellations/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "AI Stream Reliability",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "targets": [
        {"expr": "sum(rate(im_ai_stream_finalize_retries_total[1m]))", "legendFormat": "finalize retries/s"},
        {"expr": "sum(rate(im_ai_stream_finalize_failures_total[1m]))", "legendFormat": "finalize failures/s"},
        {"expr": "sum(rate(im_ai_stream_runtime_stale_repairs_total[1m]))", "legendFormat": "runtime stale repairs/s"},
        {"expr": "sum(rate(im_ai_stream_startup_stale_repairs_total[1m]))", "legendFormat": "startup stale repairs/s"},
        {"expr": "sum(rate(im_ai_stream_terminal_cas_conflicts_total[1m]))", "legendFormat": "terminal CAS conflicts/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Release Gate Routing",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 48},
      "targets": [
        {"expr": "sum(rate(im_redis_presence_route_cache_hits_total[1m]))", "legendFormat": "redis route cache hits/s"},
        {"expr": "sum(rate(im_redis_presence_route_cache_misses_total[1m]))", "legendFormat": "redis route cache misses/s"},
        {"expr": "sum(rate(im_redis_presence_stale_cleanup_total[1m]))", "legendFormat": "stale cleanup/s"},
        {"expr": "sum(rate(im_session_count_query_failures_total[1m]))", "legendFormat": "session count failures/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox Publication Age",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
      "targets": [
        {"expr": "max(im_outbox_oldest_pending_age_millis)", "legendFormat": "oldest pending ms"},
        {"expr": "sum(im_outbox_backlog_events)", "legendFormat": "pending events"},
        {"expr": "sum(rate(im_outbox_failed_events_total[1m]))", "legendFormat": "publish failures/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Conversation Shard Migration",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
      "targets": [
        {"expr": "sum(rate(im_conversation_shard_migration_copy_successes_total[5m]))", "legendFormat": "copy successes/s"},
        {"expr": "sum(rate(im_conversation_shard_migration_copy_failures_total[5m]))", "legendFormat": "copy failures/s"},
        {"expr": "sum(rate(im_conversation_shard_migration_verify_successes_total[5m]))", "legendFormat": "verify successes/s"},
        {"expr": "sum(rate(im_conversation_shard_migration_verify_failures_total[5m]))", "legendFormat": "verify failures/s"},
        {"expr": "sum(rate(im_conversation_shard_migration_remote_page_failures_total[5m]))", "legendFormat": "remote page failures/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Cross-Cell Migration Transfer",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 64},
      "targets": [
        {"expr": "sum(rate(im_conversation_shard_migration_remote_pages_total[5m]))", "legendFormat": "pages/s"},
        {"expr": "sum(rate(im_conversation_shard_migration_remote_page_records_total[5m]))", "legendFormat": "records/s"},
        {"expr": "sum(rate(im_conversation_shard_migration_remote_page_bytes_total[5m]))", "legendFormat": "bytes/s"},
        {"expr": "max(im_conversation_shard_migration_remote_page_latency_avg_millis)", "legendFormat": "average latency ms"},
        {"expr": "max(im_conversation_shard_migration_remote_page_latency_max_millis)", "legendFormat": "maximum latency ms"}
      ]
    }
  ]
}
